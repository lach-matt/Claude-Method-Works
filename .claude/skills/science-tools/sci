declare -A SIZE=( [gr]="~1.2 GB" [cas]="~0.5 GB" [sage]="~1.6 GB" [provers]="~0.2 GB" [lean]="~3.5 GB"
  [coq]="~1.2 GB" [numerics]="~1.1 GB" [dedalus]="~0.9 GB" [data]="~0.4 GB" [cosmo]="~0.3 GB"
  [gw]="~0.6 GB" [lit]="~0.2 GB" [tex]="~0.5 GB" )

