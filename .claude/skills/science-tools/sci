cl.compute(); l = cl.lensed_cl(2500); T0 = cl.T_cmb()*1e6
Dc = l['tt'][220]*220*221/(2*3.141592653589793)*T0**2
rep(abs(cl.age() - 13.80) < 0.03, "classy      age = %.4f Gyr, sigma8 = %.4f, D_220^TT = %.1f muK^2" % (cl.age(), cl.sigma8(), Dc))
