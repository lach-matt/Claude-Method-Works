    mkdir -p "$R/var/lib/texmf/web2c/pdftex" && cd "$R/var/lib/texmf/web2c/pdftex" || exit 13
    pdftex -ini -jobname=pdflatex -progname=pdflatex -etex -interaction=nonstopmode pdflatex.ini > "$SCI_ROOT/logs/tex-fmt.log" 2>&1 || exit 14
    pdftex -ini -jobname=pdftex -progname=pdftex -etex -interaction=nonstopmode pdfetex.ini >> "$SCI_ROOT/logs/tex-fmt.log" 2>&1 || true
    mktexlsr "$R/var/lib/texmf" >/dev/null 2>&1
  ) || die "TeX configuration step failed (code $?); see $SCI_ROOT/logs/tex-*.log"
  mark_ok tex "debs: $R" "texmf.cnf: $T/cnf/texmf.cnf"
}

