raise SystemExit(0 if ok else 1)
PYEOF
}

check_gw() {
  PYV gw <<'PYEOF'
import warnings; warnings.filterwarnings('ignore')
import numpy as np
ok = True
def rep(good, msg):
    global ok; ok &= bool(good); print(('ok  ' if good else 'FAIL') + ' ' + msg)
import lal, lalsimulation as ls
hp, hc = ls.SimInspiralChooseTDWaveform(30*lal.MSUN_SI, 30*lal.MSUN_SI, 0, 0, 0, 0, 0, 0, 400e6*lal.PC_SI, 0, 0, 0, 0, 0,
                                        1/4096., 20., 20., None, ls.GetApproximantFromString('IMRPhenomD'))
pk = np.max(np.abs(hp.data.data)); rep(1e-21 < pk < 3e-21, "lalsimulation IMRPhenomD 30+30 Msun @400 Mpc: %d samples, peak |h+| = %.3e" % (hp.data.length, pk))
import qnm
om = qnm.modes_cache(s=-2, l=2, m=2, n=0)(a=0.0)[0]
rep(abs(om - (0.373672 - 0.088962j)) < 2e-6, "qnm         Schwarzschild (2,2,0) M*omega = %.6f%+.6fi (Leaver 0.373672-0.088962i)" % (om.real, om.imag))
import pykerr
Ms = lal.MTSUN_SI; f = pykerr.qnmfreq(1.0, 0.0, 2, 2, 0); tau = pykerr.qnmtau(1.0, 0.0, 2, 2, 0)
w = 2*np.pi*f*Ms; gi = Ms/tau
rep(abs(w - om.real) < 1e-5 and abs(gi + om.imag) < 1e-5, "pykerr      M*omega = %.6f - %.6fi (agrees with qnm)" % (w, gi))
from pybhpt.geo import KerrGeodesic; from pybhpt.teuk import TeukolskyMode; from pybhpt.flux import FluxMode
geo = KerrGeodesic(0.0, 10.0, 0.0, 1.0, nsamples=2**4); tot = 0.0
for l in range(2, 13):
    for m in range(1, l+1):
        T = TeukolskyMode(-2, l, m, 0, 0, geo); T.solve(geo); F = FluxMode(geo, T); tot += 2*(F.energy["I"] + F.energy["H"])
rep(abs(tot/6.15163e-5 - 1) < 1e-4, "pybhpt      Schwarzschild r0=10M circular, Edot(l<=12) = %.6e (ref 6.15163e-5)" % tot)
