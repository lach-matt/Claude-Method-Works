  cat "$R"/var/lib/tex-common/fontmap-cfg/*/*.cfg 2>/dev/null | grep -E '^(Map|MixedMap|KanjiMap) ' | sort -u > "$T/cnf/updmap.cfg"
  local E="export TEXMFCNF=\"$T/cnf\" PERL5LIB=\"$R/usr/share/texlive/tlpkg\"
$(ld_block "$R")"
  rm -rf "$SCI_ROOT/bin/tex"; mkdir -p "$SCI_ROOT/bin/tex"
  wrap_bins tex "$R" "$E"
  write_env tex "" "$E"
  (
    eval "$E"; export PATH="$SCI_ROOT/bin/tex:$PATH"
    updmap-sys --nohash --cnffile "$T/cnf/updmap.cfg" > "$SCI_ROOT/logs/tex-updmap.log" 2>&1 || exit 11
    for d in "$R/usr/share/texlive/texmf-dist" "$R/usr/share/texmf" "$R/var/lib/texmf"; do
      rm -f "$d/ls-R"; printf '%% ls-R -- filename database for kpathsea; do not change this line.\n' > "$d/ls-R"
    done
