Dl = r.get_cmb_power_spectra(p, CMB_unit='muK')['total'][220, 0]
rep(abs(s8 - 0.811) < 0.005 and abs(age - 13.79) < 0.02, "camb %s   sigma8 = %.4f, age = %.4f Gyr, D_220^TT = %.1f muK^2" % (camb.__version__, s8, age, Dl))
from classy import Class
cl = Class(); cl.set({'output': 'tCl,pCl,lCl,mPk', 'lensing': 'yes', 'h': 0.674, 'omega_b': 0.0224, 'omega_cdm': 0.12,
