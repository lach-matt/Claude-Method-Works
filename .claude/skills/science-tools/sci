# --------------------------------------------------------------------------------------------- helpers
log()  { printf '[sci] %s\n' "$*" >&2; }
die()  { printf '[sci] ERROR: %s\n' "$*" >&2; exit 1; }
venv() { echo "$SCI_ROOT/venv/$1"; }
droot(){ echo "$SCI_ROOT/deb/$1"; }

guard_root() {
  local r top
  r="$(readlink -m "$SCI_ROOT")"
  top="$(git -C "$SCI_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$top" ] && [[ "$r/" == "$(readlink -m "$top")/"* ]]; then
    die "SCI_ROOT=$r is inside the repository ($top). Use a path outside it (default /root/sci)."
  fi
  case "$r" in
    /|/usr|/usr/*|/etc|/etc/*|/bin|/bin/*|/lib|/lib/*|/var/lib/*|"$HOME"|"$HOME/.local"|"$HOME/.local/"*)
      die "SCI_ROOT=$r would write into a system or user-site location; refused." ;;
  esac
  mkdir -p "$SCI_ROOT"/{venv,deb,bin,env,state,tmp,logs,opt,cache,conda}
}

is_installed() { [ -f "$SCI_ROOT/state/$1.ok" ]; }
mark_ok() {
  local g=$1; shift
  { echo "installed $(date -u +%FT%TZ)"; echo "by $SCI_SELF"; printf '%s\n' "$@"; } > "$SCI_ROOT/state/$g.ok"
}

mkvenv() { # name python
  local v; v="$(venv "$1")"
  [ -x "$2" ] || die "interpreter $2 not found (needed for venv $1)"
  if [ ! -x "$v/bin/python" ]; then
    log "creating venv $1 with $("$2" -c 'import sys;print(sys.version.split()[0])')"
    "$2" -m venv "$v" || die "venv creation failed: $v"
  fi
}

pipin() { # venv-name pkgs...
  local n=$1; shift
  local v; v="$(venv "$n")"
  log "pip install into venv/$n: $*"
  "$v/bin/python" -m pip install --progress-bar off -q "$@" > "$SCI_ROOT/logs/pip-$n.log" 2>&1 \
    || { tail -20 "$SCI_ROOT/logs/pip-$n.log" >&2; die "pip install failed in venv/$n (log: $SCI_ROOT/logs/pip-$n.log)"; }
  "$v/bin/python" -m pip freeze > "$SCI_ROOT/state/$n.freeze" 2>/dev/null || true
}

# Report what a pip install of these packages WOULD change in the system python (3.11). Informational:
# the real install always goes into an isolated venv, so the system python is never modified.
sys_dryrun() { # label pkgs...
  [ "${SCI_NO_DRYRUN:-0}" = 1 ] && return 0
  local label=$1; shift
  local d; d="$(mktemp -d "$SCI_ROOT/tmp/dry.XXXXXX")"
  if ! "$PY311" -m venv --system-site-packages "$d/v" >/dev/null 2>&1; then
    log "dry-run ($label): could not create probe venv; skipped"; rm -rf "$d"; return 0
  fi
  if "$d/v/bin/python" -m pip install --dry-run -q --report "$d/r.json" "$@" > "$d/log" 2>&1; then
    "$PY311" -I - "$d/r.json" "$label" <<'PYEOF' | tee "$SCI_ROOT/state/$label.dryrun" >&2
import json, sys, importlib.metadata as md
rep = json.load(open(sys.argv[1])); label = sys.argv[2]
inst = {i["metadata"]["name"].lower(): i["metadata"]["version"] for i in rep.get("install", [])}
watch = ["numpy", "scipy", "sympy", "mpmath"]
hits = []
for w in watch:
    if w in inst:
        try: cur = md.version(w)
        except md.PackageNotFoundError: cur = "absent"
        hits.append("%s %s -> %s" % (w, cur, inst[w]))
if hits:
    print("[sci] dry-run vs SYSTEM python (%s): WOULD CHANGE %s -- harmless here (isolated venv), "
          "but never install these into the system python" % (label, "; ".join(hits)))
else:
    print("[sci] dry-run vs SYSTEM python (%s): numpy/scipy/sympy/mpmath unchanged (%d new dists would be added)"
          % (label, len(inst)))
PYEOF
  else
    log "dry-run ($label): resolver failed against the system python: $(tail -1 "$d/log")"
  fi
  rm -rf "$d"
}

# ---- Ubuntu archive, private apt state (never touches the system dpkg database or /var/cache/apt)
APT_DIR="$SCI_ROOT/apt"
apt_opts() {
  APT_OPTS=(-o "Dir::Etc::sourcelist=$APT_DIR/sources.list" -o "Dir::Etc::sourceparts=$APT_DIR/sources.list.d"
            -o "Dir::State::Lists=$APT_DIR/lists" -o "Dir::Cache=$APT_DIR/cache" -o "Debug::NoLocking=1"
            -o "APT::Sandbox::User=root" -o "Acquire::Retries=3" -q)
  [ -n "${HTTPS_PROXY:-${https_proxy:-}}" ] && APT_OPTS+=(-o "Acquire::https::Proxy=${HTTPS_PROXY:-${https_proxy:-}}")
  [ -f "$CA_BUNDLE" ] && APT_OPTS+=(-o "Acquire::https::CAInfo=$CA_BUNDLE")
}
apt_update() {
  apt_opts
  mkdir -p "$APT_DIR"/{lists/partial,cache/archives/partial,sources.list.d,debs}
  if [ ! -f "$APT_DIR/sources.list" ]; then
    local k=/usr/share/keyrings/ubuntu-archive-keyring.gpg c
    c="$( . /etc/os-release 2>/dev/null; echo "${VERSION_CODENAME:-noble}")"
    {
      echo "deb [signed-by=$k] https://archive.ubuntu.com/ubuntu $c main universe restricted multiverse"
      echo "deb [signed-by=$k] https://archive.ubuntu.com/ubuntu $c-updates main universe restricted multiverse"
      echo "deb [signed-by=$k] https://security.ubuntu.com/ubuntu $c-security main universe restricted multiverse"
    } > "$APT_DIR/sources.list"
  fi
  if [ -z "$(find "$APT_DIR/lists" -maxdepth 1 -name '*Packages*' -mmin -1440 2>/dev/null | head -1)" ]; then
    log "apt-get update (private lists in $APT_DIR)"
    apt-get "${APT_OPTS[@]}" update > "$SCI_ROOT/logs/apt-update.log" 2>&1 \
      || { tail -5 "$SCI_ROOT/logs/apt-update.log" >&2; die "private apt-get update failed"; }
  fi
}
# apt_fetch <group> "<pkgs resolved with deps>" "<pkgs fetched alone>"
apt_fetch() {
  local g=$1 pkgs=$2 nodeps=${3:-}
  apt_update
  local R D plan list f
  R="$(droot "$g")"; D="$APT_DIR/debs/$g"
  mkdir -p "$R" "$D"
  # Simulation only (-s): prints the plan relative to the system's dpkg status, installs nothing.
  plan="$(apt-get "${APT_OPTS[@]}" -s install --no-install-recommends $pkgs 2>&1)" \
    || { echo "$plan" | tail -5 >&2; die "apt dependency simulation failed for: $pkgs"; }
  list="$(awk '/^Inst /{v=$3; if (v ~ /^\[/) v=$4; gsub(/[()]/,"",v); print $2"="v}' <<<"$plan")"
  for f in $nodeps; do list="$list"$'\n'"$f"; done
  log "apt-get download ($g): $(echo $list | wc -w) debs"
  (cd "$D" && apt-get "${APT_OPTS[@]}" download $list > "$SCI_ROOT/logs/apt-download-$g.log" 2>&1) \
    || { tail -5 "$SCI_ROOT/logs/apt-download-$g.log" >&2; die "apt-get download failed ($g)"; }
  : > "$SCI_ROOT/state/$g.debs"
  for f in "$D"/*.deb; do
    dpkg-deb -x "$f" "$R" || die "dpkg-deb -x failed on $f"
    echo "$(md5sum < "$f" | cut -c1-32)  $(basename "$f")" >> "$SCI_ROOT/state/$g.debs"
  done
  rm -f "$D"/*.deb
  # absolute symlinks that point at files we extracted: point them inside the prefix instead
  find "$R" -type l -lname '/*' 2>/dev/null | while read -r f; do
    local t; t="$(readlink "$f")"
    [ -e "$R$t" ] && ln -sfn "$R$t" "$f"
  done
  return 0
}

# ---- wrappers and environment files
mkwrap() { # group name target [env-block]
  local g=$1 n=$2 tgt=$3 envb=${4:-}
  mkdir -p "$SCI_ROOT/bin/$g"
  printf '#!/bin/sh\n# generated by sci (group %s) -- re-create with: sci install %s\n%s\nexec "%s" "$@"\n' \
    "$g" "$g" "$envb" "$tgt" > "$SCI_ROOT/bin/$g/$n"
  chmod +x "$SCI_ROOT/bin/$g/$n"
}
ld_block() { # deb root -> shell line prepending its libraries
  printf 'export LD_LIBRARY_PATH="%s/usr/lib/%s:%s/usr/lib:%s/lib/%s${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"' \
    "$1" "$LIBARCH" "$1" "$1" "$LIBARCH"
}
wrap_bins() { # group deb-root env-block [skip-regex]
  local g=$1 R=$2 envb=$3 skip=${4:-'^$'} f n
  for f in "$R"/usr/bin/* "$R"/bin/*; do
    [ -e "$f" ] || continue; [ -x "$f" ] || continue; [ -d "$f" ] && continue
    n="$(basename "$f")"
    [[ "$n" =~ $skip ]] && continue
    [ -e "$SCI_ROOT/bin/$g/$n" ] && continue
    mkwrap "$g" "$n" "$f" "$envb"
  done
}
write_env() { # group venv-name|"" extra-lines
  local g=$1 vn=$2 extra=${3:-} f="$SCI_ROOT/env/$1.sh" vpath=""
  [ -n "$vn" ] && vpath="$(venv "$vn")/bin:"
  {
    echo "# sci environment for group '$g' -- generated; re-create with: sci install $g"
    echo "export SCI_ROOT=\"$SCI_ROOT\" PYTHONNOUSERSITE=1"
    [ -n "$vn" ] && echo "export VIRTUAL_ENV=\"$(venv "$vn")\""
    echo "export PATH=\"$SCI_ROOT/bin/$g:$vpath\$PATH\""
    [ -n "$extra" ] && echo "$extra"
  } > "$f"
}

# ---- conda-forge via micromamba (bootstrapped from conda.anaconda.org itself)
MM="$SCI_ROOT/conda/bin/micromamba"
mamba_boot() {
  if [ ! -x "$MM" ]; then
    log "fetching micromamba from conda-forge"
    mkdir -p "$SCI_ROOT/conda"
    curl -fsSL "$MAMBA_URL" | tar -xj -C "$SCI_ROOT/conda" bin/micromamba || die "micromamba download failed"
  fi
  export MAMBA_ROOT_PREFIX="$SCI_ROOT/conda/root"
}
mamba_env() { # env-name specs...
  local n=$1; shift
  mamba_boot
  local e="$SCI_ROOT/conda/envs/$n" ssl=()
  [ -f "$CA_BUNDLE" ] && ssl=(--ssl-verify "$CA_BUNDLE")
  if [ ! -d "$e/conda-meta" ]; then
    log "micromamba create $n: $*"
    "$MM" create -y -q -p "$e" -c conda-forge --override-channels "${ssl[@]}" "$@" > "$SCI_ROOT/logs/mamba-$n.log" 2>&1 \
      || { tail -10 "$SCI_ROOT/logs/mamba-$n.log" >&2; rm -rf "$MAMBA_ROOT_PREFIX/pkgs"; die "micromamba create $n failed"; }
  fi
  rm -rf "$MAMBA_ROOT_PREFIX/pkgs"     # the package cache is as large as the env; never keep it
  "$MM" list -p "$e" > "$SCI_ROOT/state/conda-$n.list" 2>/dev/null || true
}

# --------------------------------------------------------------------------------------------- groups
install_gr() {
  sys_dryrun gr $REQ_gr
  mkvenv gr "$PY311"; pipin gr $REQ_gr
  if [ -x "$PY313" ]; then
    mkvenv gr313 "$PY313"; pipin gr313 $REQ_gr313
    mkwrap gr ogrepy-python "$(venv gr313)/bin/python"
  else
    log "no $PY313: OGRePy (needs Python >= 3.13) skipped"
  fi
  write_env gr gr "export MPLBACKEND=Agg"
  mark_ok gr "venv: $(venv gr)" "venv: $(venv gr313)"
}

install_cas() {
  local R; R="$(droot cas)"
  apt_fetch cas "$DEB_cas" "$NODEP_cas"
  mkvenv cas312 "$PY312"; pipin cas312 $REQ_cas312
  # REDUCE (SourceForge freestanding build; redpsl works headless, redcsl needs X11 libs)
  local O="$SCI_ROOT/opt/reduce"
  if [ ! -x "$O/current/redpsl" ]; then
    log "fetching REDUCE from SourceForge"
    mkdir -p "$O"; curl -fsSL -o "$O/reduce.tar.bz2" "$REDUCE_URL" || die "REDUCE download failed"
    local m; m="$(md5sum < "$O/reduce.tar.bz2" | cut -c1-32)"
    if [ -n "$REDUCE_MD5" ] && [ "$m" != "$REDUCE_MD5" ]; then die "REDUCE md5 $m != pinned $REDUCE_MD5 (set SCI_REDUCE_MD5= to accept)"; fi
    tar -xjf "$O/reduce.tar.bz2" -C "$O" || die "REDUCE extract failed"
    rm -f "$O/reduce.tar.bz2"
    ln -sfn "$(ls -d "$O"/reduce-snapshot_* | tail -1)" "$O/current"
  fi
  rm -rf "$SCI_ROOT/bin/cas"; mkdir -p "$SCI_ROOT/bin/cas"
  local L; L="$(ld_block "$R")"
  local CP="export PYTHONPATH=\"$R/usr/lib/python3/dist-packages\""
  mkwrap cas cadabra2 "$(venv cas312)/bin/python" "$L
$CP
set -- \"$R/usr/bin/cadabra2\" \"\$@\""
  mkwrap cas cadabra-python "$(venv cas312)/bin/python" "$L
$CP"
  mkwrap cas reduce "$O/current/redpsl"
  mkwrap cas redpsl "$O/current/redpsl"
  wrap_bins cas "$R" "$L" '^(cadabra2|cadabra2python|cadabra2-gtk|cadabra2cadabra|cadabra2html|cadabra2ipynb|cadabra2latex|cdb-nbtool|cadabra-server|xmaxima|parform|dh_installtex)$'
  write_env cas "" "$L"
  mark_ok cas "debs: $R" "reduce: $(readlink -f "$O/current")" "venv: $(venv cas312)"
}

install_sage() {
  sys_dryrun sage $REQ_sage
  mkvenv sage "$PY311"; pipin sage $REQ_sage
  write_env sage sage ""
  mark_ok sage "venv: $(venv sage)"
}

install_provers() {
  local R; R="$(droot provers)"
  sys_dryrun provers $REQ_provers
  mkvenv provers "$PY311"; pipin provers $REQ_provers
  apt_fetch provers "$DEB_provers"
  # QEPCAD reads $qe/default.qepcadrc and $qe/bin/qepcad.help; point it at the private Singular
  sed -i "s|^SINGULAR .*|SINGULAR $R/usr/bin|" "$R/usr/lib/qepcad/default.qepcadrc"
  local L; L="$(ld_block "$R")
export qe=\"$R/usr/lib/qepcad\" SINGULARPATH=\"$R/usr/share/singular/LIB\" SINGULAR_PROCS_DIR=\"$R/usr/libexec/$LIBARCH/singular/MOD\"
export SET_MM=\"$R/usr/share/metamath/databases/set.mm\""
  rm -rf "$SCI_ROOT/bin/provers"; mkdir -p "$SCI_ROOT/bin/provers"
  wrap_bins provers "$R" "$L"
  write_env provers provers "$L"
  mark_ok provers "venv: $(venv provers)" "debs: $R"
}

install_lean() {
  mamba_env lean lean4
  local E="$SCI_ROOT/conda/envs/lean"
  rm -rf "$SCI_ROOT/bin/lean"
  mkwrap lean lean "$E/bin/lean"; mkwrap lean lake "$E/bin/lake"
  write_env lean "" ""
  mark_ok lean "conda env: $E"
}

install_coq() {
  local R; R="$(droot coq)"
  apt_fetch coq "$DEB_coq"
  printf 'destdir="%s"\npath="%s:%s"\n' "$R/usr/lib/ocaml" "$R/usr/lib/ocaml" "$R/usr/lib/$LIBARCH/ocaml" > "$R/findlib.conf"
  local L; L="$(ld_block "$R")
export OCAMLFIND_CONF=\"$R/findlib.conf\" COQLIB=\"$R/usr/lib/ocaml/coq\" OCAMLLIB=\"$R/usr/lib/ocaml\""
  rm -rf "$SCI_ROOT/bin/coq"; mkdir -p "$SCI_ROOT/bin/coq"
  wrap_bins coq "$R" "$L"
  write_env coq "" "$L"
  mark_ok coq "debs: $R"
}

