#!/usr/bin/env bash
# sci -- science toolchain for the research board (GR, brane worlds, cosmology, quantum, number theory).
#
#   sci list                      groups, what each gives, and what is installed
#   sci install <group>...        idempotent install into $SCI_ROOT  (also: default, all)
#   sci run <group> <cmd...>      run a command inside that group's environment
#   sci check [group...]          smoke-test installed groups with one small real computation each
#   sci env <group>               print the group's environment (source it in another shell)
#   sci dryrun <group>            pip --dry-run of the group's packages against the SYSTEM python
#   sci du | sci remove <group> | sci clean
#
# Everything lives under SCI_ROOT (default /root/sci), which must not be inside the repository.
# Routes, and only these: PyPI (pip into venvs, PYTHONNOUSERSITE=1, no --user), the Ubuntu archive
# (archive.ubuntu.com / security.ubuntu.com: `apt-get download` + `dpkg-deb -x` into a private prefix;
# the dependency set comes from a *simulated* `apt-get -s install`, which installs nothing),
# conda-forge via micromamba (conda.anaconda.org), and SourceForge (REDUCE).
# Nothing is fetched from GitHub or any GitHub-content mirror.

set -uo pipefail

SCI_ROOT="${SCI_ROOT:-/root/sci}"
SCI_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SCI_DIR="$(dirname "$SCI_SELF")"
CA_BUNDLE="${SCI_CA_BUNDLE:-/root/.ccr/ca-bundle.crt}"
PY311="${SCI_PY311:-$(command -v python3.11 || command -v python3)}"
PY312="${SCI_PY312:-/usr/bin/python3.12}"
PY313="${SCI_PY313:-/usr/bin/python3.13}"
LIBARCH=x86_64-linux-gnu
MAMBA_URL="https://conda.anaconda.org/conda-forge/linux-64/micromamba-2.9.0-0.tar.bz2"
REDUCE_URL="${SCI_REDUCE_URL:-https://sourceforge.net/projects/reduce-algebra/files/snapshot_2026-03-08/linux64/reduce-freestanding_2026-03-08_x86_64.tar.bz2/download}"
REDUCE_MD5="${SCI_REDUCE_MD5:-00b0008635f3bf140433eef7e55b1dbc}"

export PYTHONNOUSERSITE=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_INPUT=1
unset PIP_USER PYTHONPATH PYTHONHOME
if [ -f "$CA_BUNDLE" ]; then
  export PIP_CERT="$CA_BUNDLE" SSL_CERT_FILE="$CA_BUNDLE" REQUESTS_CA_BUNDLE="$CA_BUNDLE" CURL_CA_BUNDLE="$CA_BUNDLE"
fi

ALL_GROUPS="gr cas sage provers lean coq numerics dedalus data cosmo gw lit tex"
DEFAULT_GROUPS="gr cas provers numerics data cosmo gw lit tex"

declare -A DESC=(
  [gr]="GR tensor algebra in Python: EinsteinPy, GraviPy, pytearcat (py3.11 venv); OGRePy (py3.13 venv, command ogrepy-python)"
  [cas]="CAS engines: Maxima 5.46 + ctensor/itensor, Cadabra2 2.4.5, PARI/GP 2.15, FORM 4.3, GiNaC ginsh, REDUCE (2026-03) + EXCALC/Redlog"
  [sage]="SageMath parts via passagemath-symbolics + passagemath-maxima (SageManifolds, Sage's symbolic ring) -- ~1.5 GB"
  [provers]="cvc5 + z3 (py venv), Metamath + set.mm, SPASS 3.9, QEPCAD-B 1.74 (+ Singular 4.3)"
  [lean]="Lean 4 core (conda-forge lean4; Mathlib is NOT available here) -- ~3.5 GB"
  [coq]="Coq 8.18 + Interval/Coquelicot/Flocq (Ubuntu debs) -- ~1.2 GB"
  [numerics]="py-pde, findiff, diffrax + jax (CPU), pygro (geodesics), SumOfSquares (PICOS/cvxopt), scipy, matplotlib"
  [dedalus]="Dedalus 3 spectral PDE solver (conda-forge env with FFTW/MPI; command dedalus-python) -- ~0.9 GB"
  [data]="offline data: pdg (PDG 2026 sqlite), particle, mendeleev, periodictable, radioactivedecay, xraydb, astropy (CODATA 2022, IAU, Planck18), matplotlib"
  [cosmo]="Boltzmann codes: CAMB (wheel), CLASS/classy (sdist built with the system gcc)"
  [gw]="gravitational waves: lalsuite (lal, lalsimulation), qnm, pykerr, pybhpt (Teukolsky fluxes)"
  [lit]="verbatim READs: poppler (pdftotext/pdftoppm), tesseract (eng+deu), pdfplumber, pypdf, pymupdf, pylatexenc, bibtexparser, TexSoup"
  [tex]="TeX Live 2023 from Ubuntu debs (relocated): pdflatex, bibtex; latex-base/recommended/extra, pictures (TikZ), science, publishers (revtex4-2)"
