# --------------------------------------------------------------------------------------------- commands
expand_groups() {
  local out="" g
  for g in "$@"; do
    case "$g" in
      default) out="$out $DEFAULT_GROUPS" ;;
      all) out="$out $ALL_GROUPS" ;;
      *) [[ " $ALL_GROUPS " == *" $g "* ]] || die "unknown group '$g' (groups: $ALL_GROUPS)"; out="$out $g" ;;
    esac
  done
  echo $out
}

group_paths() { # every path a group owns
  local g=$1
  case "$g" in
    gr) echo "$(venv gr) $(venv gr313)" ;;
    cas) echo "$(droot cas) $(venv cas312) $SCI_ROOT/opt/reduce" ;;
    lean|dedalus) echo "$SCI_ROOT/conda/envs/$g" ;;
    provers|lit) echo "$(venv "$g") $(droot "$g")" ;;
    coq|tex) echo "$(droot "$g")" ;;
    *) echo "$(venv "$g")" ;;
  esac
  echo "$SCI_ROOT/bin/$g $SCI_ROOT/env/$g.sh"
}
group_mb() { local p t=0 s; for p in $(group_paths "$1"); do [ -e "$p" ] && { s=$(du -sm "$p" 2>/dev/null | cut -f1); t=$((t+s)); }; done; echo "$t"; }

cmd_list() {
  printf '%-9s %-15s %s\n' GROUP STATUS "WHAT IT GIVES"
  local g st
  for g in $ALL_GROUPS; do
    if is_installed "$g"; then st="installed $(group_mb "$g")M"; else st="- (${SIZE[$g]})"; fi
    printf '%-9s %-15s %s\n' "$g" "$st" "${DESC[$g]}"
  done
  echo
  echo "default set (sci install default): $DEFAULT_GROUPS"
  echo "SCI_ROOT=$SCI_ROOT   free disk: $(df -h --output=avail "$(readlink -m "$SCI_ROOT/..")" 2>/dev/null | tail -1 | tr -d ' ')"
}

cmd_install() {
  [ $# -ge 1 ] || die "usage: sci install <group>... | default | all"
  guard_root
  local g force=0 args=()
  for g in "$@"; do [ "$g" = "--force" ] && force=1 || args+=("$g"); done
  for g in $(expand_groups "${args[@]}"); do
    if is_installed "$g" && [ $force = 0 ]; then log "$g already installed (sci install --force $g to redo)"; continue; fi
    rm -f "$SCI_ROOT/state/$g.ok"
    log "installing $g -> $SCI_ROOT  ($(df -h --output=avail "$SCI_ROOT" | tail -1 | tr -d ' ') free)"
    local t0=$SECONDS
    ( "install_$g" ) || die "install of $g failed"
    log "$g installed in $((SECONDS - t0)) s, $(group_mb "$g") MB"
  done
}

cmd_run() {
  [ $# -ge 2 ] || die "usage: sci run <group> <cmd...>"
  local g=$1; shift
  is_installed "$g" || die "group $g is not installed (run: sci install $g)"
  # shellcheck disable=SC1090
  . "$SCI_ROOT/env/$g.sh"
  exec "$@"
}

cmd_check() {
  local gs g rc=0 t0 out st
  if [ $# -gt 0 ]; then gs="$(expand_groups "$@")"; else gs=""; for g in $ALL_GROUPS; do is_installed "$g" && gs="$gs $g"; done; fi
  [ -n "${gs// /}" ] || { echo "no groups installed (sci install default)"; return 1; }
  mkdir -p "$SCI_ROOT/tmp" "$SCI_ROOT/logs"
  for g in $gs; do
    if ! is_installed "$g"; then printf '%-9s SKIP  (not installed)\n' "$g"; continue; fi
    t0=$SECONDS
    out="$( ( set +e; . "$SCI_ROOT/env/$g.sh"; "check_$g" ) 2>"$SCI_ROOT/logs/check-$g.err" )"; st=$?
    echo "$out" > "$SCI_ROOT/logs/check-$g.log"
    if [ $st = 0 ]; then printf '%-9s PASS  (%ss)\n' "$g" $((SECONDS - t0)); else printf '%-9s FAIL  (%ss)  stderr: %s\n' "$g" $((SECONDS - t0)) "$SCI_ROOT/logs/check-$g.err"; rc=1; fi
    echo "$out" | sed 's/^/          /'
  done
  return $rc
}

cmd_env() { [ $# = 1 ] || die "usage: sci env <group>"; is_installed "$1" || die "$1 not installed"; cat "$SCI_ROOT/env/$1.sh"; }

cmd_dryrun() {
  [ $# = 1 ] || die "usage: sci dryrun <group>"; guard_root
  local v="REQ_$1"; [ -n "${!v:-}" ] || die "group $1 has no pip packages for the system python (py3.11)"
  SCI_NO_DRYRUN=0 sys_dryrun "$1" ${!v}
}

cmd_remove() {
  [ $# -ge 1 ] || die "usage: sci remove <group>..."
  local g p
  for g in $(expand_groups "$@"); do
    for p in $(group_paths "$g"); do rm -rf "$p"; done
    rm -f "$SCI_ROOT/state/$g".*; [ "$g" = gr ] && rm -f "$SCI_ROOT/state/gr313".*
    log "removed $g"
  done
}

cmd_du() {
  local g
  for g in $ALL_GROUPS; do is_installed "$g" && printf '%-9s %6s MB\n' "$g" "$(group_mb "$g")"; done
  printf '%-9s %6s MB   (apt lists, micromamba, caches, logs)\n' other \
    "$(( $(du -sm "$SCI_ROOT" | cut -f1) - $(for g in $ALL_GROUPS; do is_installed "$g" && group_mb "$g"; done | awk '{s+=$1} END{print s+0}') ))"
  printf '%-9s %6s MB   %s\n' total "$(du -sm "$SCI_ROOT" | cut -f1)" "$SCI_ROOT"
}

cmd_clean() { rm -rf "$SCI_ROOT/apt/lists" "$SCI_ROOT/apt/cache" "$SCI_ROOT/apt/debs" "$SCI_ROOT/conda/root" "$SCI_ROOT/tmp"/*; log "cleaned caches"; }

usage() { sed -n '2,15p' "$SCI_SELF" | sed 's/^# \{0,1\}//'; }

main() {
  local c=${1:-help}; shift || true
  case "$c" in
    list|ls) cmd_list ;;
    install) cmd_install "$@" ;;
    run) cmd_run "$@" ;;
    check) cmd_check "$@" ;;
    env) cmd_env "$@" ;;
    dryrun) cmd_dryrun "$@" ;;
    remove|rm) cmd_remove "$@" ;;
    du) cmd_du ;;
    clean) cmd_clean ;;
    help|-h|--help) usage ;;
    *) usage; exit 2 ;;
  esac
}
main "$@"
