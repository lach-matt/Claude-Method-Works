#!/usr/bin/env bash
# wl -- evaluate Wolfram Language through Mathics3 (open source; a subset of Mathematica, not Mathematica itself).
#   wl 'Expand[(x+1)^3]' 'Integrate[1/(2 (2 r - 3)^2), {r, 2, Infinity}]'   each argument evaluated and printed
#   wl -f file.wl                                                            run a file (use Print[] inside it)
# Installs Mathics3 from pypi on first use (the container is ephemeral; pypi is on the proxy allowlist).
set -euo pipefail
if ! command -v mathics >/dev/null 2>&1 || ! python3 -c 'import mathics, requests' >/dev/null 2>&1; then
  python3 -m pip install -q mathics3 requests >/dev/null 2>&1
fi
if [ "${1:-}" = "-f" ]; then
  [ -n "${2:-}" ] || { echo "wl: -f needs a file" >&2; exit 2; }
  f=$(realpath "$2")
  code="Get[\"$f\"]"
else
  [ "$#" -gt 0 ] || { echo "usage: wl 'expr' ... | wl -f file.wl" >&2; exit 2; }
  code=""
  for e in "$@"; do code="${code}Print[(${e})]; "; done
fi
# Mathics3 quirks: only the first -c is run, -script prints nothing, and an open stdin hangs it.
exec timeout "${WL_TIMEOUT:-600}" mathics -q --colors NoColor -c "${code}" -c 'Quit[]' </dev/null
