R2 -- source-at-infinity focus and units
  z_f = b/tan(4M/b) -> b^2/(4M) + O(M)                                   ok 
  f = b^2 c^2/(4 G M) after M_geo = GM/c^2                               ok 
  thin lens 1/D_s + 1/D_i = 1/f solved                                   ok 
  D_i - f = f^2/(D_s - f) > 0 for D_s > f                                ok 
  D_i -> f as D_s -> oo                                                  ok 

