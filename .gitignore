__pycache__/
*.py[cod]

# graphify intermediate sidecars (final outputs graph.json/graph.html/GRAPH_REPORT.md are tracked)
graphify-out/.graphify_*
graphify-out/.chunk*
graphify-out/.needs_update
graphify-out/2026-*/
# The ROOT graphify-out/cache/ is TRACKED. It is the extraction cache, and
# gitignoring it is why a rebuild in a fresh container pays a cold semantic
# pass: the 2026-09-04 graph replayed 11,583 nodes from a cache that never
# travelled with the repository. Banked so a rebuild resumes. Nested scratch
# caches under a scoped run stay ignored.
# a detect run scoped to a subdirectory writes its own graphify-out/ there;
# these are unanchored so that scratch never lands in a generated tree
*/graphify-out/cache/
*/*/graphify-out/cache/
**/graphify-out/.graphify_*
**/graphify-out/.chunk*

# staged by method/bin/stage-gate; census output, never committed
method/DEFECT-CENSUS.tsv
method/gate-log.tsv

# buildtrace count cache; keyed by manifest md5, rebuilt on demand
.buildtrace-cache.json
