{"nodes": [{"id": "recovered_session_92_combined_handoff", "label": "Session 92 Combined Handoff", "file_type": "document", "source_file": "recovered/SESSION-92-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_session_92_combined_ruling_y_no_residue", "label": "Ruling Y: A Completed Solution Has No Residue", "file_type": "concept", "source_file": "recovered/SESSION-92-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M's answer to whether a computed two-term attribution discharges the residue: branch Y - a residue means not finished."}, {"id": "recovered_session_92_combined_slater_screening_s1", "label": "First-Order Slater Screening S1 = F0 - X", "file_type": "concept", "source_file": "recovered/SESSION-92-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carries 78-108% of S at 10/10 channels with exchange at most 4% of F0, and gets the own-over-other direction 5/5 - but the 0.88 VALUE is not first order, and P is not either (at Z=90 5f the bare proton is 16% of the swing)."}, {"id": "recovered_session_92_combined_second_plateau", "label": "The Second Plateau: 0.59 -> 0.88 Is Carried by P_oth", "file_type": "concept", "source_file": "recovered/SESSION-92-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Channel self-response to the entrant is tiny (<0.01) and to the proton large (64% at 90 5f), leaving a channel-self own ratio of 0.59 with spread 0.041; the lift to 0.88 is the core contracting under the proton, 33-74%."}, {"id": "recovered_session_92_combined_residue_p_minus_dz", "label": "Residue R = P - dZ (~0.06 Ha, Field-Computed, Not Closed)", "file_type": "concept", "source_file": "recovered/SESSION-92-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "S behaves as an eigenvalue quantity (dN = S to 3%) and P does not (dZ - P is 18-27%), so the 0.88 is an eigenvalue/total-energy mixture that L5 cannot close alone. Three unexplained flat numbers stand: 0.59, 0.88, 0.06."}], "edges": [{"source": "recovered_session_92_combined_handoff", "target": "recovered_session_91_combined_handoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-92-COMBINED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_session_92_combined_handoff", "target": "recovered_session_92_combined_ruling_y_no_residue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-92-COMBINED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_session_92_combined_handoff", "target": "recovered_session_92_combined_slater_screening_s1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-92-COMBINED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_session_92_combined_slater_screening_s1", "target": "recovered_session_91_combined_swing_decomposition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-92-COMBINED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_session_92_combined_second_plateau", "target": "recovered_session_92_combined_slater_screening_s1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-92-COMBINED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_session_92_combined_residue_p_minus_dz", "target": "recovered_session_90_combined_one_proton_swing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-