{"nodes": [{"id": "recovered_prediction_l2_finite_nucleus_prediction_l2_finite_nucleus", "label": "PREDICTION-L2: the finite nucleus, the last unbounded link", "file_type": "document", "source_file": "recovered/PREDICTION-L2-FINITE-NUCLEUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "L2 is the only one of the twelve assembly links carrying no number; this file predicts the number before it is measured, and is scored only after its own sha is verified."}, {"id": "recovered_prediction_l2_finite_nucleus_l2_link_point_nucleus_infinite_mass", "label": "L2: Born-Oppenheimer, point nucleus, infinite nuclear mass (APPROXIMATION, UNBOUNDED)", "file_type": "rationale", "source_file": "recovered/PREDICTION-L2-FINITE-NUCLEUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_l2_finite_nucleus_monotonicity_bounding_argument", "label": "Monotonicity choice of Li(3), Ac(89), Z=120: the two halves of L2 run in opposite directions in Z", "file_type": "rationale", "source_file": "recovered/PREDICTION-L2-FINITE-NUCLEUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Finite size grows with Z and finite mass shrinks with Z, so bounding the lightest and the heaviest row bounds every row between and no interior row need ever be run."}, {"id": "recovered_prediction_l2_finite_nucleus_finite_size_first_order_shift", "label": "Finite-size shift dE from first-order perturbation on the converged sealed orbitals with a uniform-sphere V_finite", "file_type": "rationale", "source_file": "recovered/PREDICTION-L2-FINITE-NUCLEUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The integral form is used rather than |psi(0)|^2 because the scalar-relativistic P diverges mildly at the origin (P ~ r^gamma, gamma = 0.76 at Z=89) and the density-at-a-point form is undefined there; no sealed file is edited."}, {"id": "recovered_prediction_l2_finite_nucleus_cancellation_in_the_decision", "label": "S2: the shift cancels in D, the only quantity the walk uses (|dD| < 0.05 mHa, |dD|/dE < 1e-4)", "file_type": "rationale", "source_file": "recovered/PREDICTION-L2-FINITE-NUCLEUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The differentiating electron is d or f with no density at the nucleus, so the shift enters only through core relaxation; a |dD| at or above the floor would force every quoted margin in the project to be re-read."}, {"id": "recovered_prediction_l2_finite_nucleus_normal_mass_shift_exact_invariance", "label": "M1: reduced mass scales every energy by mu/m, so the argmin is invariant exactly, not to within a bound", "file_type": "rationale", "source_file": "recovered/PREDICTION-L2-FINITE-NUCLEUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_l2_finite_nucleus_specific_mass_shift_bounded_not_measured", "label": "M2: the specific mass shift is bounded (|dD_SMS| <~ (m/M)|D|, 0.016 mHa at Z=3), not measured", "file_type": "rationale", "source_file": "recovered/PREDICTION-L2-FINITE-NUCLEUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The mass-polarisation operator is a genuine two-electron term this field does not carry and does not scale uniformly; declaring it a bound now stops a bound being read as a measurement later."}, {"id": "recovered_prediction_l2_finite_nucleus_what_a_pass_buys", "label": "What a pass buys, stated so it cannot be overclaimed", "file_type": "rationale", "source_file": "recovered/PREDICTION-L2-FINITE-NUCLEUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pass moves L2 from unbounded to bounded with the bound stated; it does not make the nucleus finite in the walk."}, {"id": "recovered_prediction_l2_finite_nucleus_assembly_rung_0", "label": "ASSEMBLY-RUNG-0.md ledger of twelve links", "file_type": "concept", "source_file": "recovered/PREDICTION-L2-FINITE-NUCLEUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_prediction_l2_finite_nucleus_prediction_l2_finite_nucleus", "target": "recovered_prediction_l2_finite_nucleus_l2_link_point_nucleus_infinite_mass", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-L2-FINITE-NUCLEUS.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_l2_finite_nucleus_l2_link_point_nucleus_infinite_mass", "target": "recovered_prediction_l2_finite_nucleus_assembly_rung_0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-L2-FINITE-NUCLEUS.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_l2_finite_nucleus_monotonicity_bounding_argument", "target": "recovered_prediction_l2_finite_nucleus_prediction_l2_finite_nucleus", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-L2-FINITE-NUCLEUS.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_l2_finite_nucleus_prediction_l2_finite_nucleus", "target": "recovered_prediction_l2_finite_nucleus_finite_size_first_order_shift", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-L2-FINITE-NUCLEUS.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_l2_finite_nucleus_cancellation_in_the_decision", "target": "recovered_prediction_l2_finite_nucleus_finite_size_first_order_shif