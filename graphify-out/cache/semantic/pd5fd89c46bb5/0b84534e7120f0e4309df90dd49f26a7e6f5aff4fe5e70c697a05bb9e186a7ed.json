{"nodes": [{"id": "recovered_result_s97_items_1_5_core_core_resummation", "label": "Two-State Resummation of the 7s^2 -> 6d^2 Block", "file_type": "concept", "source_file": "recovered/RESULT-S97-ITEMS-1-5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PR3 is sign-exact for ANY Delta > 0 because resummation can only reduce |E_PT|; the direction of the core-core differential therefore does not depend on the gap value, which is what lets a value-estimate carry an exact sign."}, {"id": "recovered_result_s97_items_1_5_slot_rule_decision", "label": "Slot Rule Decided by External Can-Fail ((1-f) over exclusion)", "file_type": "rationale", "source_file": "recovered/RESULT-S97-ITEMS-1-5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The core object's own 6p-7s pair, containing no 6d anywhere, is an external reference: (1-f) returns +9.4% and passes, exclusion returns -50% and fails. The asymmetry of F96.3 is thereby measured rather than argued, and the s95 exclusion rule is retired for the differential."}, {"id": "recovered_result_s97_items_1_5_so97", "label": "so97.py (Koelling-Harmon spin-orbit xi scan)", "file_type": "code", "source_file": "recovered/RESULT-S97-ITEMS-1-5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_result_s97_items_1_5_dirac_kernel_non_gating", "label": "Dirac Kernel Declared NON-GATING Above Z=112", "file_type": "rationale", "source_file": "recovered/RESULT-S97-ITEMS-1-5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No predicted row 109-120 has a worst-case first-order SO shift exceeding its margin, and the 7p split re-orders j-components within a shell rather than the n+l entrant; even a factor-2 underestimate of the 7p1/2 contraction leaves every verdict unchanged, so the kernel is recommended not built and the math decides."}, {"id": "recovered_result_s97_items_1_5_f97_1", "label": "F97.1 \u2014 Occupancy Parser Added q-1 Electrons", "file_type": "concept", "source_file": "recovered/RESULT-S97-ITEMS-1-5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_result_s97_items_1_5_f97_2", "label": "F97.2 \u2014 PS1 xi Range Falsified at Z=113", "file_type": "concept", "source_file": "recovered/RESULT-S97-ITEMS-1-5.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_result_s97_items_1_5_slot_rule_decision", "target": "recovered_result_s96_v5_rows_f96_3", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/RESULT-S97-ITEMS-1-5.md", "source_location": null, "weight": 1.0}, {"source": "recovered_result_s97_items_1_5_core_core_resummation", "target": "recovered_result_s96_v5_rows_core_core_differential", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/RESULT-S97-ITEMS-1-5.md", "source_location": null, "weight": 1.0}, {"source": "recovered_result_s97_items_1_5_core_core_resummation", "target": "recovered_result_s95_v5_row89_criterion_3", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/RESULT-S97-ITEMS-1-5.md", "source_location": null, "weight": 1.0}, {"source": "recovered_result_s97_items_1_5_so97", "target": "recovered_result_s97_items_1_5_dirac_kernel_non_gating", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/RESULT-S97-ITEMS-1-5.md", "source_location": null, "weight": 1.0}, {"source": "recovered_result_s97_items_1_5_f97_1", "target": "recovered_result_s97_items_1_5_so97", "relation": "references", "confidence": "EXTRACTED", "confidence_sco