{"nodes": [{"id": "recovered_prediction_collapse_kappa_document", "label": "PREDICTION-COLLAPSE-KAPPA (s51)", "file_type": "document", "source_file": "recovered/PREDICTION-COLLAPSE-KAPPA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_collapse_kappa_kappa_indicator", "label": "kappa(n,l,Z) = D_field / (-1/(2n^2)) \u2014 the collapse indicator", "file_type": "concept", "source_file": "recovered/PREDICTION-COLLAPSE-KAPPA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pure ratio of the field's own channel depth to the hydrogenic depth at unit net charge; -1/(2n^2) enters as a denominator, not a parameter, so no fitted or measured quantity is introduced. kappa=1 means uncollapsed, kappa>1 collapsed."}, {"id": "recovered_prediction_collapse_kappa_g_channel_hydrogenic_pinning", "label": "Every g channel returns the hydrogenic depth exactly (delta = 0, not in the field)", "file_type": "concept", "source_file": "recovered/PREDICTION-COLLAPSE-KAPPA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_collapse_kappa_tie_break_domain", "label": "The tie-break clause given a stated domain rather than three exceptions", "file_type": "rationale", "source_file": "recovered/PREDICTION-COLLAPSE-KAPPA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If kappa separates collapsed from uncollapsed channels, La/Ac/Th are not failures of the rule but the rule applied outside its domain: lower n first among equal n+l, over the channels that are in the field."}, {"id": "recovered_prediction_collapse_kappa_pk_4_sharp_collapse", "label": "PK-4: the collapse is sharp in Z, not gradual", "file_type": "concept", "source_file": "recovered/PREDICTION-COLLAPSE-KAPPA.md", "source_