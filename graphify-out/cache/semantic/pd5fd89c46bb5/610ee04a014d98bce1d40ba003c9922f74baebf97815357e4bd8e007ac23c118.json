{"nodes": [{"id": "recovered_prediction_frachfs5_session_34_prediction_frachfs5_s34", "label": "PREDICTION-FRACHFS5 (session 34): one correlation form S on the O-path class row", "file_type": "document", "source_file": "recovered/PREDICTION-FRACHFS5-SESSION-34.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "F34.3 was owed: the observable-path class row had to be computed under a single correlation form so rows are comparable."}, {"id": "recovered_prediction_frachfs5_session_34_correlation_form_s", "label": "Correlation form S = R + screened SOX (SOSEX-screened GB-Z)", "file_type": "rationale", "source_file": "recovered/PREDICTION-FRACHFS5-SESSION-34.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as the standing form so the class row is one form rather than a mixture; the prediction bounds how far S may move a row from R (<=0.002)."}, {"id": "recovered_prediction_frachfs5_session_34_class_row_order_invariance", "label": "Class row keeps order Sc < Gd < La < Lu < Y < Cs and its sign change under S", "file_type": "rationale", "source_file": "recovered/PREDICTION-FRACHFS5-SESSION-34.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order invariance under a change of correlation form is the falsifiable content: any row moving >0.003, or an order change, is a failure."}], "edges": [{"source": "recovered_prediction_frachfs5_session_34_prediction_frachfs5_s34", "target": "recovered_prediction_frachfs5_session_34_correlation_form_s", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-FRACHFS5-SESSION-34.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_frachfs5_session_34_prediction_frachfs5_s34", "target": "recovered_prediction_frachfs5_session_34_class_row_o