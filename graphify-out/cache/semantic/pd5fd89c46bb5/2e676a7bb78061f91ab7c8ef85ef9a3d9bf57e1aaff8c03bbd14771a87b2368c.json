{"nodes": [{"id": "recovered_handoff_27_handoff_27", "label": "HANDOFF-27 (chat 75 to chat 76)", "file_type": "document", "source_file": "recovered/HANDOFF-27.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_27_section_0_gate", "label": "Section 0 Gate (eight-step chat-open ritual)", "file_type": "rationale", "source_file": "recovered/HANDOFF-27.md", "source_location": "lines 7-36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every chat must reproduce the two live bundles byte-exactly before any work: each step is its own tool call under timeout 280 and any FAIL stops the chat with a report, so a chat can never build on a bundle it has not proved."}, {"id": "recovered_handoff_27_bootstrap_decode_extract", "label": "Bundle bootstrap: decode, md5, extract members", "file_type": "rationale", "source_file": "recovered/HANDOFF-27.md", "source_location": "lines 11-31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only gate step outside gate.py, because gate.py is itself a member and cannot be run before the members exist; it asserts the md5 of each bundle and refuses to overwrite an existing file."}, {"id": "recovered_handoff_27_build90_main_bundle", "label": "BUILD90 main and register bundle", "file_type": "concept", "source_file": "recovered/HANDOFF-27.md", "source_location": "line 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen since chat 62 at 1,983,081 B / md5 49065309b0c4fe8e055f693aed295cca; Phase R2 reads main but never writes it, so only the compendia bundle advances."}, {"id": "recovered_handoff_27_build102_compendia", "label": "BUILD102 compendia papers audits", "file_type": "concept", "source_file": "recovered/HANDOFF-27.md", "source_location": "lines 3, 31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_27_r2lib", "label": "r2lib shared instrument library", "file_type": "concept", "source_file": "recovered/HANDOFF-27.md", "source_location": "line 49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Functions are lifted into r2lib verbatim with a provenance comment rather than reimplemented, so a later instrument measures with the same code that banked the earlier golden; what is not yet lifted is tracked in DEFERRED.md."}, {"id": "recovered_handoff_27_gate_py", "label": "gate.py (census, run, manifest, cert, bank)", "file_type": "concept", "source_file": "recovered/HANDOFF-27.md", "source_location": "lines 32-36", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_27_close_py_guarded_build", "label": "close.py guarded build with reverse-md5 guard", "file_type": "rationale", "source_file": "recovered/HANDOFF-27.md", "source_location": "line 55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "close.py appends the W entry and the new members, rewrites MANIFEST.tsv, asserts that only WORKING-REGISTER.md, MANIFEST.tsv and appended members changed, and must print that the reverse operation recovers the OLD bundle's md5 before writing: a seated member is never edited in place."}, {"id": "recovered_handoff_27_rulings_r2", "label": "RULINGS-R2.md (append-only ruling store)", "file_type": "concept", "source_file": "recovered/HANDOFF-27.md", "source_location": "line 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_27_deferred", "label": "DEFERRED.md (cross-chapter deferred items)", "file_type": "concept", "source_file": "recovered/HANDOFF-27.md", "source_location": "line 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Governs carried items so they are not re-derived; each chat appends one block and the file's byte count and md5 are pinned in the next handoff."}, {"id": "recovered_handoff_27_working_register_w_series", "label": "WORKING-REGISTER.md W-series entries", "file_type": "concept", "source_file": "recovered/HANDOFF-27.md", "source_location": "lines 4, 54", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_27_ruling_41_carried_state", "label": "Ruling 41: carried state to discard", "file_type": "rationale", "source_file": "recovered/HANDOFF-27.md", "source_location": "line 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The standing prompt block's Phase 0-4 Lowdin / three-body plan is executed work, already MEASURED in W-107; re-opening it or putting it to M would spend a chat on a closed question."}, {"id": "recovered_handoff_27_segment_cadence", "label": "Per-segment R2 cadence (one or two subsections, closed before the next opens)", "file_type": "rationale", "source_file": "recovered/HANDOFF-27.md", "source_location": "lines 42-49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A segment is closed (files written, md5s measured, golden banked) before the next opens, so a chat that runs out of context leaves no half-read section behind."}, {"id": "recovered_handoff_27_handoff_never_a_member", "label": "Rule: never add HANDOFF-NN.md as a member", "file_type": "rationale", "source_file": "recovered/HANDOFF-27.md", "source_location": "line 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A handoff is transfer apparatus, not content of the work; seating one would put a retired instruction inside the bundle the gate verifies."}], "edges": [{"source": "recovered_handoff_27_handoff_27", "target": "recovered_handoff_27_section_0_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/HANDOFF-27.md", "sourc