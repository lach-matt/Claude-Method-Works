{"nodes": [{"id": "recovered_result_s99_cc89_dcc89_refile", "label": "dcc(89) Re-Filed, Superseding the s97 Band", "file_type": "concept", "source_file": "recovered/RESULT-S99-CC89.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The s97 band's lower end was raw PT over a 27 mHa denominator (an overestimate) and its upper end used a wrong-provenance V^2; the ruling that the own-slot denominator is the shell's SEALED eps is what fixes the den that pairs with the piece."}, {"id": "recovered_result_s99_cc89_one_rule_five_rows", "label": "One Partition Rule Covering All Five Chain Rows", "file_type": "rationale", "source_file": "recovered/RESULT-S99-CC89.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single filed rule across 38/56/72/89/105 removes the per-row discretion that made F98.1 possible; every row widens and no corner of any bracket flips, which is the claim the five-row table is allowed to make."}], "edges": [{"source": "recovered_result_s99_cc89_dcc89_refile", "target": "recovered_result_s97_items_1_5_core_core_resummation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/RESULT-S99-CC89.md", "source_location": null, "weight": 1.0}, {"source": "recovered_result_s99_cc89_one_rule_five_rows", "target": "recovered_result_s98_rows_38_105_cc98", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/RESULT-S99-CC89.md", "source_location": null, "weight": 1.0}, {"source": "recovered_result_s99_cc89_one_rule_five_rows", "target": "recovered_result_s99_cc72_reread_dcc72_bracket", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/RESULT-S99-CC89.md", "source_location": null, "weight": 1.0}, {"source": "recovered_result_s99_cc89_dcc89_refile", "target": "recov