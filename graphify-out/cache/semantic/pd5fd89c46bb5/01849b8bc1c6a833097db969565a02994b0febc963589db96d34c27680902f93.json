{"nodes": [{"id": "recovered_prediction_nonrel_cinf_prediction_nonrel_cinf", "label": "PREDICTION-NONREL-CINF: Clause 3, the non-relativistic limit", "file_type": "document", "source_file": "recovered/PREDICTION-NONREL-CINF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loewdin clause 3 specifies the non-relativistic many-electron Schrodinger equation; if the ordering clause survives c -> infinity the relativistic layer is a correction the result survives, not a premise it needs."}, {"id": "recovered_prediction_nonrel_cinf_nr_1_ordering_clause_survives", "label": "NR-1 (decisive): zero ordering failures over Z = 2..108 at c = 1e6", "file_type": "rationale", "source_file": "recovered/PREDICTION-NONREL-CINF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A clause reworded to pass is FALSIFIED and recorded as such; a failure would be reported, not reinterpreted."}, {"id": "recovered_prediction_nonrel_cinf_lowdin_clause_3", "label": "Loewdin clause 3", "file_type": "concept", "source_file": "recovered/PREDICTION-NONREL-CINF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_nonrel_cinf_c_1e6_established_nonrelativistic_limit", "label": "c = 1e6 as the project's established non-relativistic limit, c a default argument on the SR solvers", "file_type": "rationale", "source_file": "recovered/PREDICTION-NONREL-CINF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Already used as a build gate, so it is not a new instrument and needs no new validation."}, {"id": "recovered_prediction_nonrel_cinf_tie_break_failures_57_89_90", "label": "NR-2: the three tie-break failures {57, 89, 90} persist at c = 1e6", "file_type": "rationale", "source_file": "recovered/PREDICTION-NONREL-CI