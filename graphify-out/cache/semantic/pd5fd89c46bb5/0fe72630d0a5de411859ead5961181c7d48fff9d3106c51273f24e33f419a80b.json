{"nodes": [{"id": "recovered_prediction_s85_item1_the_bound_variable_q_bound", "label": "The variable-q bound K < 1", "file_type": "rationale", "rationale": "K := 2 V+/(L^2 a) with V+ the positive variation of w = q - r q' across the orbit. K < 1 implies J < 2 implies dg/dl > 0 implies G-within: a DERIVED sufficient condition, reached because J_tent = 2 exactly on b0+b1 = 1 for every split.", "source_file": "recovered/PREDICTION-S85-ITEM1-THE-BOUND.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s85_item1_the_bound_tent_extremal", "label": "The one-kink tent as extreme point of the admissible set", "file_type": "concept", "rationale": "J is convex in delta and delta is affine in S, so J is maximised at an extreme point of the admissible set of S; those extreme points are one-kink tents, each of whose two pieces leaves the radicand quadratic and so has a closed form.", "source_file": "recovered/PREDICTION-S85-ITEM1-THE-BOUND.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s85_item1_the_bound_eccentricity_factor", "label": "The eccentricity factor eps = sqrt(1-(L/nu*)^2)", "file_type": "concept", "rationale": "K = V+/(c* eps), so the tolerance for screening variation IS the orbit's eccentricity: a near-circular orbit has almost none. This is what accounts for Z=90 \u2014 the 5f orbit is near-circular and its tolerance for the core's shed charge is correspondingly small.", "source_file": "recovered/PREDICTION-S85-ITEM1-THE-BOUND.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s85_item1_the_bound_population_declaration", "label": "Populations R, A and B declared before scoring", "file_type": "rationale", "rationale": "F83.1's species pre-empted at its twelfth appearance: the row set R (FAIL, CONTROL and HEAVY rows) is fixed here and not to be extended before scoring, and every clause names A (the width-2 frontier) or B explicitly.", "source_file": "recovered/PREDICTION-S85-ITEM1-THE-BOUND.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s85_item1_the_bound_magnitude_not_claimed", "label": "The magnitude of dg/dl is not claimed", "file_type": "concept", "source_file": "recovered/PREDICTION-S85-ITEM1-THE-BOUND.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_prediction_s85_item1_the_bound_variable_q_bound", "target": "recovered_prediction_s84_item1_semiclassical_anchor_theorem", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S85-ITEM1-THE-BOUND.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s85_item1_the_bound_tent_extremal", "target": "recovered_prediction_s85_item1_the_bound_variable_q_bound", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S85-ITEM1-THE-BOUND.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s85_item1_the_bound_variable_q_bound", "target": "recovered_prediction_s83_item1_gladder_g_within", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S85-ITEM1-THE-BOUND.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s85_item1_the_bound_eccentricity_factor", "target": "recovered_prediction_s81_item1_z90fixed_z90_last_6d_row", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S85-ITEM1-THE-BOUND.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s85_item1_the_bound_population_declaration", "target": "recove