{"nodes": [{"id": "recovered_prediction_s92_item2_relax_relaxation_split", "label": "Relaxation split into S1c, S_self, S_oth, P_self, P_oth", "file_type": "rationale", "source_file": "recovered/PREDICTION-S92-ITEM2-RELAX.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splits the gap S - S1 by WHICH response carries it: the channel's own orbital response, everyone else's, and the frozen change of the SIC-correlation potential. S_self <= 0 and P_self <= 0 are variational, so they are sign-exact predictions rather than estimates."}, {"id": "recovered_prediction_s92_item2_relax_rho2", "label": "rho2 = (S1c + S_self)/|P1 + P_self| (channel's own self-consistent ratio)", "file_type": "concept", "source_file": "recovered/PREDICTION-S92-ITEM2-RELAX.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the plateau closes at rho2 the residue collapses to S_oth/P_oth; if not, the others' response is required and that ratio becomes the named, field-computed residue. Either branch ends in a named object."}, {"id": "recovered_prediction_s92_item2_relax_sic_correlation_piece", "label": "SIC-correlation piece S_c = S1c - S1", "file_type": "concept", "source_file": "recovered/PREDICTION-S92-ITEM2-RELAX.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reported as its own piece because item 1's S1 omitted the V_c change; predicted small (|S_c| < 0.02 Ha) so the omission is quantified rather than assumed harmless."}], "edges": [{"source": "recovered_prediction_s92_item2_relax_relaxation_split", "target": "recovered_prediction_s92_item1_sp_first_order_s1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S92-ITEM2-RELAX.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s92_item2_relax_sic_correlation_piece", "target": "recovered_prediction_s92_item1_sp_first_order_s1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S92-ITEM2-RELAX.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s92_item2_relax_rho2", "target": "recovered_prediction_s92_item1_sp_rho_plateau_088", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S92-ITEM2-RELAX.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s92_item2_relax_rho2", "target": "recovered_prediction_s92_item2_relax_relaxation_split", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S92-ITEM2-RELAX.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s92_item2_relax_relaxation_split", "target": "recovered_prediction_s92_item1_sp_residue_not_finished", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S92-ITEM2-RELAX.md", "source_location": null, "weight": 1.0}], "hyperedges": []}