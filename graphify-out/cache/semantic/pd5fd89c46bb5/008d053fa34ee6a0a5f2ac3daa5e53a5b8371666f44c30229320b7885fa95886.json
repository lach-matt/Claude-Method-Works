{"nodes": [{"id": "recovered_handoff_11_handoff_11", "label": "HANDOFF-11 \u2014 The Method 1.6 (chat 61 \u2192 chat 62, BUILD75)", "file_type": "document", "source_file": "recovered/HANDOFF-11.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Post-restart lineage: the handoff is identified by the chat that wrote it and the build it describes, and its \u00a70 gate is the first act of the next chat."}, {"id": "recovered_handoff_11_self_identification_triple", "label": "SELF-IDENTIFICATION \u2014 the three must agree with the files", "file_type": "rationale", "source_file": "recovered/HANDOFF-11.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handoff, build and Register range are stated so a disagreement with the uploaded files stops work instead of being absorbed."}, {"id": "recovered_handoff_11_batch_7_mc_36_41", "label": "Batch 7 \u2014 MC-36\u2026MC-41 authored and seated", "file_type": "concept", "source_file": "recovered/HANDOFF-11.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_11_batch_8_mc_42_51", "label": "Batch 8 \u2014 MC-42\u2026MC-51 DONE-by-existing (bound, nothing authored)", "file_type": "concept", "source_file": "recovered/HANDOFF-11.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A work item can close by being already seated elsewhere; the binding table is the certificate."}, {"id": "recovered_handoff_11_batch_9_pc_01_04", "label": "Batch 9 \u2014 PC-01\u2026PC-04", "file_type": "concept", "source_file": "recovered/HANDOFF-11.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PC-03 was expanded with a sourced rotational-invariance clause after the gyroscopic-rigidity framing was