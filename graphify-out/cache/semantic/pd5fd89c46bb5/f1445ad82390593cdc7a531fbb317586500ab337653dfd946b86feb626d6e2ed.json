{"nodes": [{"id": "recovered_register_chat_the_register_chat", "label": "THE REGISTER CHAT \u2014 one page that replaces the transcripts", "file_type": "document", "source_file": "recovered/REGISTER-CHAT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One page exists so keeping the register current never requires reading a transcript; the other documents are read only when a slip needs adjudicating."}, {"id": "recovered_register_chat_single_writer_register", "label": "The register is a single-writer object (R 1726)", "file_type": "rationale", "source_file": "recovered/REGISTER-CHAT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A chat that computes does not number its finding: ids are allocated where the file lives, in one sequence, so parallel chats cannot collide."}, {"id": "recovered_register_chat_slip_format", "label": "The slip \u2014 SOURCE / ARTEFACT / TITLE / BODY, no R number", "file_type": "concept", "source_file": "recovered/REGISTER-CHAT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A slip carries no R number because numbering belongs to the allocator, and ARTEFACT: TRANSCRIPT-ONLY is admitted but flagged because drafting from a summary while the file is unread is a named fault."}, {"id": "recovered_register_chat_regchat_py", "label": "regchat.py \u2014 open / ingest / close", "file_type": "code", "source_file": "recovered/REGISTER-CHAT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ingest refuses rather than coerces: it fails on unbalanced markers, false headings, a missing field, an R number claimed in a slip, or a duplicate id."}, {"id": "recovered_register_chat_canonical_register_count_entries", "label": "Canonical register count is `entries` (R 1730)", "file_type": "rationale", "source_file": "recovered/REGISTER-CHAT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One declared instrument is named so the certificate's register clause measures one quantity; the instrument prints all three readings and gates on duplicates."}, {"id": "recovered_register_chat_state_nothing_before_it_prints", "label": "State nothing about the work before the instrument prints", "file_type": "rationale", "source_file": "recovered/REGISTER-CHAT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R 1685 / R 1697: the opening run verifies, gates and counts, and no claim about state precedes it."}], "edges": [{"source": "recovered_register_chat_single_writer_register", "target": "recovered_register_chat_the_register_chat", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/REGISTER-CHAT.md", "source_location": null, "weight": 1.0}, {"source": "recovered_register_chat_the_register_chat", "target": "recovered_register_chat_slip_format", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/REGISTER-CHAT.md", "source_location": null, "weight": 1.0}, {"source": "recovered_register_chat_the_register_chat", "target": "recovered_register_chat_regchat_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/REGISTER-CHAT.md", "source_location": null, "weight": 1.0}, {"source": "recovered_register_chat_canonical_register_count_entries", "target": "recovered_register_chat_regchat_py", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/REGISTER-CHAT.md", "source_location": null, "weight": 1.0}, {"source": "recovered_register_chat_state_nothing_before_it_prints", "target": "recovered_register_chat_regcha