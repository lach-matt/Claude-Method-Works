{"nodes": [{"id": "extracted_projects_the_method_clique3_finding_clique3_obstruction", "label": "The Clique-3 Obstruction", "file_type": "concept", "source_file": "extracted/projects/the-method/CLIQUE3-FINDING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "106 corridors, 735 edges, density 0.132, max clique 3, minimum stabbing points at 0.7071, 1.7071, 2.4409; agreed by two independent routes."}, {"id": "extracted_projects_the_method_clique3_finding_generating_form_g", "label": "The Generating Form g(p) = 1/(sqrt(p+2) - sqrt(p))", "file_type": "concept", "source_file": "extracted/projects/the-method/CLIQUE3-FINDING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "g increases because sqrt is concave, so the bands ascend and tile only when p advances by 2."}, {"id": "extracted_projects_the_method_clique3_finding_canonical_bands", "label": "The Four Canonical Bands", "file_type": "concept", "source_file": "extracted/projects/the-method/CLIQUE3-FINDING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "p=0 with 26 members, p=2 {La, Gd}, p=3 {Ac, Th, Cm}, p=5 {Lr}; the p=3 band overlaps p=2, which is why the answer is 3 and not 4."}, {"id": "extracted_projects_the_method_clique3_finding_lawrencium_forced", "label": "Only Lawrencium Is Forced", "file_type": "concept", "source_file": "extracted/projects/the-method/CLIQUE3-FINDING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "205 maximum cliques, not one; 57 of 106 vertices appear in some maximum clique and Lr alone appears in all 205."}, {"id": "extracted_projects_the_method_clique3_finding_correction_r1517", "label": "Correction to R 1517's Attribution", "file_type": "concept", "source_file": "extracted/projects/the-method/CLIQUE3-FINDING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R 1517's 'forced by three elements - boron, lanthanum and lawrencium' is corrected: boron is the first member of a 26-element class selected by the greedy scan's ordering."}], "edges": [{"source": "extracted_projects_the_method_clique3_finding_clique3_obstruction", "target": "extracted_projects_the_method_clique3_finding_generating_form_g", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/projects/the-method/CLIQUE3-FINDING.md", "source_location": null, "weight": 1.0}, {"source": "extracted_projects_the_method_clique3_finding_generating_form_g", "target": "extracted_projects_the_method_clique3_finding_canonical_bands", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/projects/the-method/CLIQUE3-FINDING.md", "source_location": null, "weight": 1.0}, {"source": "extracted_projects_the_method_clique3_finding_canonical_bands", "target": "extracted_projects_the_method_clique3_finding_lawrencium_forced", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/projects/the-method/CLIQUE3-FINDING.md", "source_location": null, "weight": 1.0}, {"source": "extracted_projects_the_method_clique3_finding_lawrencium_forced", "target": "extracted_projects_the_method_clique3_finding_correction_r1517", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/projects/the-method/CLIQUE3-FINDING.md", "source_location": null, "weight": 1.0}, {"source": "extracted_projects_the_method_clique3_finding_clique3_obstruction", "target": "extracted_projects_the_method_code_lowdin_2_13_brack_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/projects/the-method/CLIQUE3-FINDING.md", "source_location": null, "w