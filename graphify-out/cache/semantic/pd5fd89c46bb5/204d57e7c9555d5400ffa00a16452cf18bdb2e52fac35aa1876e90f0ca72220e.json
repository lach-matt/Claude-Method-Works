{"nodes": [{"id": "recovered_fault_f63_1_open_n_inference_f63_1", "label": "Fault F63.1 \u2014 open58.sh infers the seal number from directory names and halts falsely", "file_type": "document", "source_file": "recovered/FAULT-F63.1-OPEN-N-INFERENCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_fault_f63_1_open_n_inference_wrong_reference", "label": "A comparison run against the wrong reference", "file_type": "concept", "source_file": "recovered/FAULT-F63.1-OPEN-N-INFERENCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "N is derived as the highest packN directory, but s62 wrote into pack61/ and never created pack62/, so STEP 1 checked the tree against the s61 LINEAGE row. The computed root was exactly the sealed s62 root: the archive was byte-for-byte correct and the instrument asked the wrong question. A false HALT naming a root MISMATCH is more dangerous than a silent pass, because the documented escalation is to distrust the handoff."}, {"id": "recovered_fault_f63_1_open_n_inference_intermediate_root", "label": "An intermediate root quoted inside the tree it describes", "file_type": "concept", "source_file": "recovered/FAULT-F63.1-OPEN-N-INFERENCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RULING-F62.1-ADOPTED states 1077 files / root 1ca50bff for a tree that sealed at 1080 / dc77adda; three files entered pack61/ after the ruling was written, including the ruling itself. A document that describes the tree it will be sealed into cannot state that tree's size correctly from inside itself."}], "edges": [{"source": "recovered_fault_f63_1_open_n_inference_f63_1", "target": "recovered_fault_f63_1_open_n_inference_wrong_reference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/FAULT-