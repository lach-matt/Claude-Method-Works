{"nodes": [{"id": "recovered_repair_floor_session_8_pack5_bisection_floor", "label": "The pack-5 bisection floor", "file_type": "concept", "source_file": "recovered/REPAIR-FLOOR-SESSION-8.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bracket's lower edge lies above deep-shell eigenvalues, so the bisection returns the bracket edge silently and a clipped energy is indistinguishable from a solved one."}, {"id": "recovered_repair_floor_session_8_eigen_fix_py", "label": "eigen_fix.py \u2014 adaptive bracket, no new constant", "file_type": "code", "source_file": "recovered/REPAIR-FLOOR-SESSION-8.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deepening is on demand and capped at the rigorous bound, so where the old floor already bracketed the result is bit-identical and an earlier deep-energy fault is not re-exposed; the suggested constant was refused because it is another chosen constant and still clips."}, {"id": "recovered_repair_floor_session_8_os_5d_solved_at_the_floor", "label": "Os 5d was solved at the floor", "file_type": "concept", "source_file": "recovered/REPAIR-FLOOR-SESSION-8.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not only its window but its orbital, integrals and derived quantity were computed at a wrong eigenvalue; after repair the result moves toward the middle of a wider window, so the standing result was not resting on the fault."}, {"id": "recovered_repair_floor_session_8_computed_tfd_floor_flag", "label": "FLAG \u2014 scan the step-2 table for cells at the floor", "file_type": "rationale", "source_file": "recovered/REPAIR-FLOOR-SESSION-8.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The large table was built with the same floor and was not audited; a value computed at a floor energy is a false value with the appearance of a measurement."}, {"id": "recovered_repair_floor_session_8_verbatim_pack_repair_in_new_files", "label": "The repair is new named files; pack artefacts stay verbatim", "file_type": "rationale", "source_file": "recovered/REPAIR-FLOOR-SESSION-8.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sealed pack is not edited, so the superseding file sits beside it and future use reads the repaired file while the original remains as evidence."}], "edges": [{"source": "recovered_repair_floor_session_8_eigen_fix_py", "target": "recovered_repair_floor_session_8_pack5_bisection_floor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/REPAIR-FLOOR-SESSION-8.md", "source_location": null, "weight": 1.0}, {"source": "recovered_repair_floor_session_8_os_5d_solved_at_the_floor", "target": "recovered_repair_floor_session_8_pack5_bisection_floor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/REPAIR-FLOOR-SESSION-8.md", "source_location": null, "weight": 1.0}, {"source": "recovered_repair_floor_session_8_computed_tfd_floor_flag", "target": "recovered_repair_floor_session_8_pack5_bisection_floor", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/REPAIR-FLOOR-SESSION-8.md", "source_location": null, "weight": 1.0}, {"source": "recovered_repair_floor_session_8_verbatim_pack_repair_in_new_files", "target": "recovered_repair_floor_session_8_eigen_fix_py", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/REPAIR-FLOOR-SESSION-8.md", "source_location": null, "weight": 1.0}, {"source": "recovered_repair_floor_session_8_pack5_bisection_floor", "target": "recovered_readme_handoff_47_f47_2_unflagged_scf_nonconvergence", "rela