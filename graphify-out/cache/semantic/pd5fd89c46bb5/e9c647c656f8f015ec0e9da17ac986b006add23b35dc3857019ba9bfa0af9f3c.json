{"nodes": [{"id": "recovered_prediction_s82_item5_f811_propagation_f81_1", "label": "F81.1 \u2014 the assumption that the stationarity ladder descends", "file_type": "concept", "rationale": "A signed quantity measured POSITIVE at 7p is named 'drop', 'TOTAL DROP', 'descending' or 'basin floor'. The question is whether the fault is a naming one or a numerical one, and that is decided by whether any external consumer reads the signed quantity.", "source_file": "recovered/PREDICTION-S82-ITEM5-F811-PROPAGATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s82_item5_f811_propagation_three_senses", "label": "S1 / S2 / S3 \u2014 three senses of 'ladder' and 'restart'", "file_type": "concept", "rationale": "S1 is nlguard's convergence RUNG ladder, S2 is nlchain's 'restart' mode against observed cfg(Z-1), S3 is restart-to-stationarity. Only S3 is F81.1's object, and the naive regex over the bare token 'ladder' over-matches by at least five files.", "source_file": "recovered/PREDICTION-S82-ITEM5-F811-PROPAGATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s82_item5_f811_propagation_one_sided_test", "label": "The one-sided termination test \u2014 the fault with teeth", "file_type": "concept", "rationale": "On a RISING ladder a signed break test either never fires or fires at pass 1, and 7p rises. Predicted absent tree-wide; its falsification would disturb a number rather than a word.", "source_file": "recovered/PREDICTION-S82-ITEM5-F811-PROPAGATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s82_item5_f811_propagation_lint_gate", "label": "The pack82 lint gate (demonstrated in both directions)", "file_type": "concept", "rationale": "The gate must FAIL against pack81 as sealed and PASS against the corrected copy; if it cannot fail on the sealed source it is not measuring anything. Sealed sites are recorded as findings, never patched.", "source_file": "recovered/PREDICTION-S82-ITEM5-F811-PROPAGATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s82_item5_f811_propagation_sealed_file_rule", "label": "SEALED-FILE RULE \u2014 no sealed file is edited", "file_type": "concept", "rationale": "The correction is written as an audit, a corrected vocabulary carried forward, and a gate that halts any FUTURE instrument committing the fault.", "source_file": "recovered/PREDICTION-S82-ITEM5-F811-PROPAGATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_prediction_s82_item5_f811_propagation_f81_1", "target": "recovered_prediction_s82_item5_f811_propagation_three_senses", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S82-ITEM5-F811-PROPAGATION.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s82_item5_f811_propagation_f81_1", "target": "recovered_prediction_s81_item1_z90fixed_f80_2_ladder_drop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S82-ITEM5-F811-PROPAGATION.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s82_item5_f811_propagation_one_sided_test", "target": "recovered_prediction_s82_item5_f811_propagation_f81_1", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S82-ITEM5-F811-PROPAGATION.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s82_item5_f811_propagation_lint_gate", "target": "recovered_prediction_s82_item5_f811_propagation_sealed_file_rule", "relation": "references", "confidence": "EXTR