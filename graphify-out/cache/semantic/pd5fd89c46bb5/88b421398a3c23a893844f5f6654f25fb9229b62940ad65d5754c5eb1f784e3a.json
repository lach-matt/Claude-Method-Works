{"nodes": [{"id": "recovered_order_for_s89__4faf5af1_order_session_89", "label": "Order for Session 89 (reverse chain)", "file_type": "document", "source_file": "recovered/ORDER-FOR-S89__4faf5af1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_order_for_s89__4faf5af1_chain_clause_1", "label": "CHAIN-CLAUSE-1: six links L1-L6", "file_type": "concept", "source_file": "recovered/ORDER-FOR-S89__4faf5af1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each link is written with statement, limit parameter, measured remainder, the R-number/session sealing it, and a status (THEOREM / IDENTITY / COMPUTED / VARIATIONAL) so that the derivation's weakest link is visible rather than buried; L6 is named VARIATIONAL and not a limit precisely so the proof form cannot claim more than it has."}, {"id": "recovered_order_for_s89__4faf5af1_reverse_chain_walk", "label": "Walk the chain backwards, limits to Schrodinger", "file_type": "rationale", "source_file": "recovered/ORDER-FOR-S89__4faf5af1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M's s88 ruling: the question is how the n+l order derives from Schrodinger's first principles, so the walk is run backwards from the order/limits to the equation using mathematics the walk has already identified, rather than forwards from first principles."}, {"id": "recovered_order_for_s89__4faf5af1_link_3_j_less_than_2", "label": "Link L3: J < 2 by convexity (tent theorem)", "file_type": "concept", "source_file": "recovered/ORDER-FOR-S89__4faf5af1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OPEN at five rows (40 4d, 56 5d, 89 6d, 90 5f, 91 5f); s88 proved no one-channel bound of the J<2 kind can certify a channel whose measured J >= 2, so the open statement is two-channel - the SIGN of Delta g between the two frontier candidates."}, {"id": "recovered_order_for_s89__4faf5af1_link_4_exchange_remainder", "label": "Link L4: Gauss convexity and the E7 exchange remainder", "file_type": "concept", "source_file": "recovered/ORDER-FOR-S89__4faf5af1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "S'' = r^2 rho >= 0 is a theorem for the direct field only; same-shell exchange breaks it at occupied channels (0.07 at Z=24, 0.28 at Z=56), so the remainder is MEASURED and bounded rather than assumed away."}, {"id": "recovered_order_for_s89__4faf5af1_well_merge", "label": "Well-merge (collapse) rows", "file_type": "concept", "source_file": "recovered/ORDER-FOR-S89__4faf5af1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_order_for_s89__4faf5af1_lever_law", "label": "Lever law (standing rule)", "file_type": "rationale", "source_file": "recovered/ORDER-FOR-S89__4faf5af1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standing discipline carried at every session close: a claim must name the lever that would move it; 16 appearances with 3 closed at s89."}], "edges": [{"source": "recovered_order_for_s89__4faf5af1_order_session_89", "target": "recovered_order_for_s89__4faf5af1_chain_clause_1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/ORDER-FOR-S89__4faf5af1.md", "source_location": null, "weight": 1.0}, {"source": "recovered_order_for_s89__4faf5af1_chain_clause_1", "target": "recovered_order_for_s89__4faf5af1_link_3_j_less_than_2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/ORDER-FOR-S89__4faf5af1.md", "source_location": null, "weight": 1.0}, {"source": "recovered_order_for_s89__4faf5af1_chain_clause_1", "target": "recovered_order_for_s89__4faf5af1_link_4_exchange_remainder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/ORDER-FOR-S89__4faf5af1.md", "source_location": null, "weight": 1.0}, {"source": "recovered_order_for_s89__4faf5af1_link_3_j_less_than_2", "target": "recovered_order_for_s89__4faf5af1_well_merge", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/ORDER-FOR-S89__4faf5af1.md", "source_location": null, "weight": 1.0}, {"source": "recovered_order_for_s89__4faf5af1_reverse_chain_walk", "target": "recovered_order_for_s89__4faf5af1_chain_clause_1", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/ORDER-FOR-S89__4faf5af1.md", "source_location": null, "weight": 1.0}, {"source": "recovered_order_for_s89__4faf5af1_order_session_89", "target": "recovered_order_for_s89__4faf5af1_lever_law", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/ORDER-FOR-S89__4faf5af1.md", "source_location": null, "weight": 1.0}], "hyperedges": []}