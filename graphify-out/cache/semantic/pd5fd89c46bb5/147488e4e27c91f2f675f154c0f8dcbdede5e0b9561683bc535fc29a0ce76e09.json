{"nodes": [{"id": "recovered_prediction_s89_unit1a_pair_l3_at_the_pair", "label": "L3 at the pair, not the channel", "file_type": "rationale", "source_file": "recovered/PREDICTION-S89-UNIT1A-PAIR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moves the test object from a single channel to the rank-1/rank-2 pair, because the S7 rule read on rank-2 alone cannot explain why Z=90 and Z=56 carry opposite banked signs with the same merge shape."}, {"id": "recovered_prediction_s89_unit1a_pair_s7_sign_rule", "label": "S7 sign rule: sign(Delta g) = sign(2 - J_rank2)", "file_type": "concept", "source_file": "recovered/PREDICTION-S89-UNIT1A-PAIR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filed to agree at >=12 of 13 rows with the single filed disagreement named in advance (Z=56, rank-2 5d J=2.441 predicts negative, banked +)."}, {"id": "recovered_prediction_s89_unit1a_pair_merge_hypothesis", "label": "The merge hypothesis (merged candidate J>=2, rival J<2)", "file_type": "rationale", "source_file": "recovered/PREDICTION-S89-UNIT1A-PAIR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filed TRUE at Z=89,90,91 and FALSE at Z=56, so the honest conclusion is recorded at filing time: THE MERGE DOES NOT BY ITSELF FIX THE SIGN. A fixed-weight criterion sign((2-J_2) - w(2-J_1)) was explicitly NOT filed because no fixed w works."}, {"id": "recovered_prediction_s89_unit1a_pair_s_entrant_exception", "label": "s-entrant exception (J_1 < 1.3 forces banked +)", "file_type": "rationale", "source_file": "recovered/PREDICTION-S89-UNIT1A-PAIR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What distinguishes Z=90 from Z=56 is the RANK-1 channel: at 90 rank-1 6d has J within 0.10 of 2 (1.906) while at 56 rank-1 6s has J ~ 1.20, so the discriminator is the entrant's own J, not the merge."}, {"id": "recovered_prediction_s89_unit1a_pair_region_count_lever", "label": "Region-count lever (rc=4 when dead)", "file_type": "concept", "source_file": "recovered/PREDICTION-S89-UNIT1A-PAIR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A lever must take at least two distinct values across the run's frontier channels or nothing is scored; rc=4 is the recorded verdict for a dead lever rather than a pass."}, {"id": "recovered_prediction_s89_unit1a_pair_nlchain_currency", "label": "Banked Delta g from rt/nlchain.jsonl (the s84 S7 currency)", "file_type": "concept", "source_file": "recovered/PREDICTION-S89-UNIT1A-PAIR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_prediction_s89_unit1a_pair_l3_at_the_pair", "target": "recovered_prediction_s89_unit1a_pair_s7_sign_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S89-UNIT1A-PAIR.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s89_unit1a_pair_s_entrant_exception", "target": "recovered_prediction_s89_unit1a_pair_merge_hypothesis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S89-UNIT1A-PAIR.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s89_unit1a_pair_s_entrant_exception", "target": "recovered_prediction_s89_unit1a_pair_s7_sign_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S89-UNIT1A-PAIR.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s89_unit1a_pair_s7_sign_rule", "target": "recovered_prediction_s89_unit1a_pair_nlchain_currency", "relation": "references", "