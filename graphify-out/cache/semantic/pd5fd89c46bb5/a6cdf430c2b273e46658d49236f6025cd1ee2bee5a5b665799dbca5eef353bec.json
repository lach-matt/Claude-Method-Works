{"nodes": [{"id": "recovered_prediction_s81_item1_z90fixed_fixed81", "label": "pack81/fixed81.py", "file_type": "concept", "source_file": "recovered/PREDICTION-S81-ITEM1-Z90FIXED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s81_item1_z90fixed_z90_last_6d_row", "label": "Z=90 \u2014 the last row 6d wins, rank 2 is 5f", "file_type": "concept", "rationale": "m(90) = 54.05 mHa and the entrant flips to 5f at Z=91, so unlike Z=89 (rank 2 = 7p, f channels CLASS B holes) this fixed-field comparison is the row's own decision.", "source_file": "recovered/PREDICTION-S81-ITEM1-Z90FIXED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s81_item1_z90fixed_relaxation_term", "label": "The relaxation term that closes the fixed-field gap", "file_type": "concept", "rationale": "At Z=89 it was 10.072 mHa and acted to close the gap, because denying the f channel its own core relaxation costs it exactly that; the mechanism is not Z-specific. A Z=90 gap below 10.1 mHa would mean relaxation erases it and the fixed-field argument carries nothing there.", "source_file": "recovered/PREDICTION-S81-ITEM1-Z90FIXED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s81_item1_z90fixed_f80_1", "label": "F80.1 \u2014 the two-member zero set and declared orientation", "file_type": "concept", "rationale": "Where the scan returns more than one zero, the selection branch (most-bound vs least-bound) must be declared; the branch that supports no self-consistent probe is reported and the surviving branch carries the result.", "source_file": "recovered/PREDICTION-S81-ITEM1-Z90FIXED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s81_item1_z90fixed_f80_2_ladder_drop", "label": "F80.2 \u2014 the restart-to-stationarity ladder drop", "file_type": "concept", "rationale": "Measured 0.034493 mHa at Z=89, monotone and geometric with ratio ~0.3, and diagnosed as a property of the STOPPING TEST rather than of any Z. If the Z=90 drop falls far outside the band, that diagnosis is wrong.", "source_file": "recovered/PREDICTION-S81-ITEM1-Z90FIXED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s81_item1_z90fixed_same_shell_asymmetry", "label": "E7's same-shell asymmetry between the l=2 and l=3 probes", "file_type": "rationale", "rationale": "The l=2 probe has a partner in its own shell and the l=3 probe does not. That is the scheme's convention, and if the gap is small the asymmetry is a candidate explanation for it rather than a nuisance.", "source_file": "recovered/PREDICTION-S81-ITEM1-Z90FIXED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_prediction_s81_item1_z90fixed_fixed81", "target": "recovered_prediction_s79_item1_fixedfield_fixed_field_comparison", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S81-ITEM1-Z90FIXED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s81_item1_z90fixed_fixed81", "target": "recovered_prediction_s81_item1_z90fixed_z90_last_6d_row", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S81-ITEM1-Z90FIXED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s81_item1_z90fixed_relaxation_term", "target": "recovered_prediction_s81_item1_z90fixed_z90_last_6d_row", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S81-ITEM1-Z90FIXED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s81_item1_z90fixed_f80_1", "target": "recovered_prediction_s80_item1_currency_fallback", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S81-ITEM1-Z90FIXED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s81_item1_z90fixed_f80_2_ladder_drop", "target": "recovered_prediction_s80_item2_oc1_oc1_falsifier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S81-ITEM1-Z90FIXED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s81_item1_z90fixed_same_shell_asymmetry", "target": "recovered_prediction_s81_item1_z90fixed_fixed81", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S81-ITEM1-Z90FIXED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s81_item1_z90fixed_fixed81", "target": "recovered_prediction_s80_item1_currency_currency_repair", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S81-ITEM1-Z90FIXED.md", "source_location": null, "weight": 1.0}], "hyperedges": []}