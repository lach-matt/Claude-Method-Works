{"nodes": [{"id": "recovered_prediction_s78_item2_seedd_seed_d", "label": "Seed D \u2014 shell-wise screened hydrogenic start", "file_type": "concept", "rationale": "Orbital (n,l) solved in pure Coulomb -Zeff(n)/r with integer screening read off the occupancy, floored at 1. No TFD, no Latter tail, no exchange, no fitted constant.", "source_file": "recovered/PREDICTION-S78-ITEM2-SEEDD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s78_item2_seedd_f78_1", "label": "F78.1 \u2014 s77 misattributed the node raise to the seed constructor", "file_type": "concept", "rationale": "The design probes showed a bare-Coulomb start constructs cleanly at Z=89 (16/16 node counts met); it is the first SCF sweep at hfc2.py:55 that raises 'Z=89 50 nodes 3'.", "source_file": "recovered/PREDICTION-S78-ITEM2-SEEDD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s78_item2_seedd_timing_flag", "label": "Declared timing flag: probes run before filing", "file_type": "rationale", "rationale": "Two design probes preceded the file, so P0/P1 are recorded as ARITHMETIC rather than predictions and only P2..P6 are risk-bearing. Declaring the order of operations is what keeps the score honest.", "source_file": "recovered/PREDICTION-S78-ITEM2-SEEDD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s78_item2_seedd_common_set_criterion", "label": "COMMON-SET criterion 2*max|differential| < m(89)", "file_type": "concept", "rationale": "The seed-independence test must be run on channels common to both candidate sets; a raw margin comparison instead fires F76.2's runner-up-substitution artefact.", "source_file": "recovered/PREDICTION-S78-ITEM2-SEEDD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s78_item2_seedd_f77_3_repair", "label": "F77.3 repair \u2014 the can-fail reachable by the driver", "file_type": "concept", "rationale": "Driver o89segD.py runs PHASE A on every invocation and refuses to solve when it returns non-zero, so the lever cannot be bypassed.", "source_file": "recovered/PREDICTION-S78-ITEM2-SEEDD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_prediction_s78_item2_seedd_f78_1", "target": "recovered_prediction_s77_z89_reseed_seedtest77", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S78-ITEM2-SEEDD.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s78_item2_seedd_seed_d", "target": "recovered_prediction_s78_item2_seedd_common_set_criterion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S78-ITEM2-SEEDD.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s78_item2_seedd_common_set_criterion", "target": "recovered_prediction_s76_modes_f76_2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S78-ITEM2-SEEDD.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s78_item2_seedd_timing_flag", "target": "recovered_prediction_s78_item2_seedd_seed_d", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S78-ITEM2-SEEDD.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s78_item2_seedd_f77_3_repair", "target": "recovered_prediction_s77_z89_reseed_lever_verified", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S78-ITEM2-SEEDD.md", "source_location": null, "weight": 1.0}, {"source":