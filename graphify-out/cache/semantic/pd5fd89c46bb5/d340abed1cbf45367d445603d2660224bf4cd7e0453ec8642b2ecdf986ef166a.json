{"nodes": [{"id": "recovered_prediction_s90_item3_l5_across_d3_collapse_transit", "label": "D3-type collapse transit (plateau then single-proton transit)", "file_type": "concept", "source_file": "recovered/PREDICTION-S90-ITEM3-L5-ACROSS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Diagnosed by |dn*/dZ| < 0.05 on a plateau for at least two rows followed by a step with |dn*/dZ| > 0.8, at 37->38 (4d) and 55->56 (5d)."}, {"id": "recovered_prediction_s90_item3_l5_across_nu_margin", "label": "Across clause nu_d - nu_s > 0 (s below d)", "file_type": "rationale", "source_file": "recovered/PREDICTION-S90-ITEM3-L5-ACROSS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filed to hold at every bound Z in both series, not just the frontier rows, with the minimum margin named in advance (0.274 at Z=56). The mechanism filed is that the d's collapse moves nu_d down toward nu_s and the surviving margin is set by the s's own penetration."}, {"id": "recovered_prediction_s90_item3_l5_across_sealed_ladder_read", "label": "Sealed-ladder-only read (NO NEW RUNS, value-exact)", "file_type": "rationale", "source_file": "recovered/PREDICTION-S90-ITEM3-L5-ACROSS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eigenvalues come from disk, so the item is VALUE-exact by construction and costs no solve; it establishes the upper bound on g(d)-g(s) through the identity g(d)-g(s) = 1 - (nu_d - nu_s)."}], "edges": [{"source": "recovered_prediction_s90_item3_l5_across_nu_margin", "target": "recovered_prediction_s90_item1_across_dl2_g_across_clause", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S90-ITEM3-L5-ACROSS.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s90_item3_l5_across_d3_c