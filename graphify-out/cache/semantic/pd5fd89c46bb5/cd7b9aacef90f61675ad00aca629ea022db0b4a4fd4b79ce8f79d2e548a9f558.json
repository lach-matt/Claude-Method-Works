{"nodes": [{"id": "drive_the_method_materials_corpus_original_3b_text_three_body_closed_index", "label": "The Three-Body Problem for Unknown Masses \u2014 A Closed Index of Families", "file_type": "paper", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A complete solution cannot be a trajectory: the number of predictions an index can make is E(X), so a complete index makes none and the answer must be an index of families."}, {"id": "drive_the_method_materials_corpus_original_3b_text_shape_sphere", "label": "The Shape Sphere", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "drive_the_method_materials_corpus_original_3b_text_jacobi_maupertuis_metric", "label": "The Jacobi\u2013Maupertuis Metric on Shape Space", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "drive_the_method_materials_corpus_original_3b_text_degree_8_norm_polynomial", "label": "The Degree-8 Norm Polynomial of the Potential", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "drive_the_method_materials_corpus_original_3b_text_law1_reduction", "label": "Law 1 \u2014 Reduction", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "drive_the_method_materials_corpus_original_3b_text_law2_time_elimination", "label": "Law 2 \u2014 Time Elimination", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "drive_the_method_materials_corpus_original_3b_text_law3_envelope", "label": "Law 3 \u2014 Envelope", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three bodies form K3, which needs strong 3-consistency where the closure operator delivers 2; therefore the exact three-body region is not a lattice and its closure is the monotone envelope."}, {"id": "drive_the_method_materials_corpus_original_3b_text_law4_completeness_prediction", "label": "Law 4 \u2014 Completeness\u2013Prediction Exclusion", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Completely solvable' and 'envelope precision only' are one statement."}, {"id": "drive_the_method_materials_corpus_original_3b_text_law5_mass_uniformity", "label": "Law 5 \u2014 Mass-Uniformity", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "drive_the_method_materials_corpus_original_3b_text_law6_threshold_silence", "label": "Law 6 \u2014 Threshold Silence", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "drive_the_method_materials_corpus_original_3b_text_five_fixed_points", "label": "The Five Fixed Points (Euler and Lagrange)", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "drive_the_method_materials_corpus_original_3b_text_five_strata_index", "label": "The Five Strata \u2014 an Index with E = 0", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "drive_the_method_materials_corpus_original_3b_text_solve_three_body_algorithm", "label": "SOLVE_THREE_BODY", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 9 is the only step that can fail, and its failure would be a discovered defect E > 0 \u2014 which requires a new certificate rather than a patch."}, {"id": "drive_the_method_materials_corpus_original_3b_text_triangle_form_computation", "label": "The Triangle Form on a Cap Grid", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Certainty survives upward and dies downward: join failures stay at 0 while meet failures grow with the cap, and the masses do not enter the triangle inequality."}, {"id": "drive_the_method_materials_corpus_original_3b_text_thirteen_order_types", "label": "The Thirteen Mass Order-Types", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-3B-TEXT.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "drive_the_method_materials_corpus_original_3b_text_audit_checks", "label": "Audit Checks A, B and E", "file_type": "concept", "source_file": "drive/The Method Materials/CORPUS/ORIGINAL-