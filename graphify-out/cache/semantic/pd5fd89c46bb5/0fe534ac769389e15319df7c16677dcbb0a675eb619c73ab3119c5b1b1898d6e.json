{"nodes": [{"id": "recovered_session_80_combined_handoff", "label": "Session 80 Combined Handoff", "file_type": "document", "source_file": "recovered/SESSION-80-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_session_80_combined_de80", "label": "de80.py (Node-Targeted Fallback)", "file_type": "concept", "source_file": "recovered/SESSION-80-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The node-targeted scan RETURNS the target state to the SCF instead of raising, so a total energy exists to difference - the change that put the Z=89 table into one currency."}, {"id": "recovered_session_80_combined_perturb80", "label": "perturb80.py (O-C1 Falsifier)", "file_type": "concept", "source_file": "recovered/SESSION-80-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_session_80_combined_currency_repair", "label": "The Z=89 Table in One Currency", "file_type": "concept", "source_file": "recovered/SESSION-80-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ten perturbation runs converted the f channels to total-energy dE: the entrant at Z=89 is 6d, ranks 1 and 2 untouched. Withdrawn multiples are SUPERSEDED by measurement, not restored."}, {"id": "recovered_session_80_combined_f80_1", "label": "F80.1 Zero Selection Undeclared (Two Zeros at One Node Count)", "file_type": "concept", "source_file": "recovered/SESSION-80-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "refine79 took the more-bound zero, de80's first draft the less-bound, and neither declared an orientation - the choice was made by geomspace argument order. Only the less-bound branch supports a self-consistent field, so pack79's three f eigenvalues are withdrawn as descriptions of the SCF states."}, {"id": "recovered_session_80_combined_f80_2", "label": "F80.2 Reference Not Stationary (0.034493 mHa Above Its Own Basin Floor)", "file_type": "concept", "source_file": "recovered/SESSION-80-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_session_80_combined_f80_3", "label": "F80.3 Tolerance Below Resolution", "file_type": "concept", "source_file": "recovered/SESSION-80-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "perturb80's TOL of 1e-6 Ha sat below the 0.0345 mHa resolution measured in the same session, so it printed 'O-C1 FALSIFIED' three times on ordinary scatter. The labels are overridden in the result and the reason recorded."}, {"id": "recovered_session_80_combined_measured_floor", "label": "A Null With a Measured Floor", "file_type": "rationale", "source_file": "recovered/SESSION-80-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bare null says nothing; a null with a measured resolution floor says how much is excluded. O-C1 is neither falsified nor established, but the falsifier is now known to resolve a competing basin only below ~0.035 mHa."}], "edges": [{"source": "recovered_session_80_combined_handoff", "target": "recovered_session_79_combined_handoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-80-COMBINED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_session_80_combined_handoff", "target": "recovered_session_80_combined_de80", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-80-COMBINED.md", "source_location": null, "weight": 1.0}, {"source": "reco