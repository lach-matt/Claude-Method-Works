{"nodes": [{"id": "recovered_session_79_combined_handoff", "label": "Session 79 Combined Handoff", "file_type": "document", "source_file": "recovered/SESSION-79-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_session_79_combined_step0ii_adoption", "label": "Step 0(ii) Adopted: The Field as Global Minimiser", "file_type": "rationale", "source_file": "recovered/SESSION-79-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The field is DEFINED as a global minimiser of E^RHF at fixed shell occupancies over Hantsch's relaxed set, so (beta, maxit) leaves the definition and the convergence ladder becomes a numerical scheme for an independently defined object. Stated on the ENERGY, never the spectrum; Lions' simplicity assertion deliberately not imported."}, {"id": "recovered_session_79_combined_obligation_o_c1", "label": "Obligation O-C1 (Reach the Global Minimiser)", "file_type": "concept", "source_file": "recovered/SESSION-79-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Load-bearing obligation registered to Route C by the Step 0(ii) adoption: the program must be SHOWN to reach the global minimiser, not assumed to."}, {"id": "recovered_session_79_combined_four_start_basin_test", "label": "Four-Start Basin Test Is Not a Proof", "file_type": "rationale", "source_file": "recovered/SESSION-79-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four seeds agreeing to 0.005 mHa from 52 Ha away, and seed D holding at Z=89 from 517 Ha away, is agreement among starts and never evidence of global minimality. The cheap falsifier - perturb a converged solution and re-converge - was still unrun."}, {"id": "recovered_session_79_combined_state_misidentification", "label": "State Misidentification (the Z=89 Hole Mechanism)", "file_type": "concept", "source_file": "recovered/SESSION-79-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "F78.2 is refuted at Z=89: the bracket expansion did not fail, it converged to a TRUE zero belonging to a different state. All five failures are RuntimeError node-count raises with zero TypeErrors."}, {"id": "recovered_session_79_combined_refine79", "label": "refine79.py (Refined Node Spectrum)", "file_type": "concept", "source_file": "recovered/SESSION-79-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_session_79_combined_fixed79", "label": "fixed79.py (Frozen-Core Probe)", "file_type": "concept", "source_file": "recovered/SESSION-79-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_session_79_combined_relaxation_term", "label": "The Relaxation Term at Z=89 (10.072 mHa)", "file_type": "concept", "source_file": "recovered/SESSION-79-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First number ever put on the relaxation term: 145.297 mHa across two fields against 155.369 mHa in one. It CLOSES the gap rather than opening it, 15.4 times smaller than the gap it would have to erase - which is what gave Clause 1 a target to aim at."}, {"id": "recovered_session_79_combined_f79_1", "label": "F79.1 Minlog Read at the Wrong End of Its Own Range", "file_type": "concept", "source_file": "recovered/SESSION-79-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_session_79_combined_f79_2", "label": "F79.2 Currency Mismatch (Total Energy vs One-Electron Eigenvalue)", "file_type": "concept", "source_file": "recovered/SESSION-79-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A total-energy difference was compared against one-electron eigenvalues; at 6d the two differ by 19.277 mHa, comparable to the 32.330 mHa margin. Registered against the session's own result, and every stated multiple of the margin withdrawn as stated."}, {"id": "recovered_session_79_combined_the_species", "label": "The Species: A Number Carried Forward Under a Name That Did Not Describe It", "file_type": "rationale", "source_file": "recovered/SESSION-79-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "F78.1 read the raise not the sentence; F79.1 read the instrument not its column label; F79.2 read the units. One recurring failure mode tracked by appearance count across sessions rather than repaired once and forgotten."}, {"id": "recovered_session_79_combined_clause_1", "label": "Clause 1 (A Cross-Channel Property of F_core)", "file_type": "concept", "source_file": "recovered/SESSION-79-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The last open deliverable: derive a property of F_core forcing eps_3^{l=3} > eps_4^{l=2}. Measurement of the inequality at its tightest instance is explicitly not a derivation of it."}], "edges": [{"source": "recovered_session_79_combined_handoff", "target": "recovered_session_79_combined_step0ii_adoption", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-79-COMBINED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_session_79_combined_obligation_o_c1", "target": "recovered_session_79_combined_step0ii_adoption", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-79-COMBINED.m