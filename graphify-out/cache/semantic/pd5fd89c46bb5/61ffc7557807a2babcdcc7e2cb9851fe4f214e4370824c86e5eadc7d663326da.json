{"nodes": [{"id": "_github_claude_github_setup_claude_github_app", "label": "Claude GitHub App install", "file_type": "concept", "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The App, not the workflow, is what gives Claude permission to speak: read a thread, post a comment, push a branch. Requires repo admin."}, {"id": "_github_claude_github_setup_repository_secret", "label": "The one repository secret", "file_type": "concept", "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly one of ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN; choosing the OAuth token requires a one-line swap in both workflow files."}, {"id": "_github_claude_github_setup_github_token_omission", "label": "github_token deliberately not passed", "file_type": "rationale", "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Omitting github_token makes the action authenticate as the Claude GitHub App; passing secrets.GITHUB_TOKEN would stop CI running on commits Claude pushes."}, {"id": "_github_claude_github_setup_default_branch_requirement", "label": "Issue and comment events run the default branch's workflow", "file_type": "rationale", "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Issue, comment and review events carry no branch, so GitHub always runs those workflows from main. claude.yml does nothing until merged there; claude-code-review.yml is the exception because pull_request runs the PR head."}, {"id": "_github_claude_github_setup_drive_only_exclusion", "label": "The drive/-only review exclusion", "file_type": "rationale", "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reviewing half a gigabyte of mirrored PDFs produces nothing useful, so PRs touching only drive/ get no review; a mixed PR is reviewed and Claude sees the drive/ hunks from the PR API rather than from disk."}, {"id": "_github_claude_github_setup_path_filter_truncation", "label": "Event path filters see only the first 300 files", "file_type": "rationale", "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The characteristic PR here is a bulk drive/ drop that also touches one file sorting after it, exactly the case a paths-ignore filter mis-reads; a skipped job also satisfies a required check where an uncreated workflow leaves it pending forever."}, {"id": "_github_claude_github_setup_concurrency_burst_drop", "label": "One pending run per concurrency group", "file_type": "rationale", "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub keeps at most one pending run per group and each new one cancels the pending predecessor, so a burst of three @claude comments answers the first and third and silently drops the second."}, {"id": "_github_claude_github_setup_two_cost_meters", "label": "Two cost meters: Actions minutes and tokens", "file_type": "concept", "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A ~508 MB checkout makes the runner meter unusually expensive here; the two workflows blunt it differently, shallow-full versus sparse-without-drive."}], "edges": [{"source": "_github_claude_github_setup_claude_github_app", "target": "_github_workflows_claude_claude_code_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "weight": 1.0}, {"source": "_github_claude_github_setup_claude_github_app", "target": "_github_workflows_claude_code_review_review_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "weight": 1.0}, {"source": "_github_claude_github_setup_repository_secret", "target": "_github_workflows_claude_claude_code_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "weight": 1.0}, {"source": "_github_claude_github_setup_github_token_omission", "target": "_github_claude_github_setup_claude_github_app", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "weight": 1.0}, {"source": "_github_claude_github_setup_default_branch_requirement", "target": "_github_workflows_claude_claude_code_workflow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "weight": 1.0}, {"source": "_github_claude_github_setup_drive_only_exclusion", "target": "_github_workflows_claude_code_review_changed_files_gate", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "weight": 1.0}, {"source": "_github_claude_github_setup_path_filter_truncation", "target": "_github_workflows_claude_code_review_changed_files_gate", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "weight": 1.0}, {"source": "_github_claude_github_setup_concurrency_burst_drop", "target": "_github_workflows_claude_job_level_concurrency", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "weight": 1.0}, {"source": "_github_claude_github_setup_two_cost_meters", "target": "_github_workflows_claude_code_review_sparse_checkout", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "weight": 1.0}, {"source": "_github_claude_github_setup_two_cost_meters", "target": "claude_drive_mirror", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".github/CLAUDE_GITHUB_SETUP.md", "source_location": null, "weight": 1.0}], "hyperedges": []}