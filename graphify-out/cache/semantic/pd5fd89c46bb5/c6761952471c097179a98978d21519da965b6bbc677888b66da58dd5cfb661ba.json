{"nodes": [{"id": "recovered_handoff_34_handoff_34", "label": "HANDOFF-34 (chat 81 to chat 82, rewritten after M's ruling)", "file_type": "document", "source_file": "recovered/HANDOFF-34.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_34_build109_compendia", "label": "BUILD109 compendia papers audits", "file_type": "concept", "source_file": "recovered/HANDOFF-34.md", "source_location": "line 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_34_chat_81_ruling_section_read", "label": "The chat-81 ruling: the section read in two batches", "file_type": "rationale", "source_file": "recovered/HANDOFF-34.md", "source_location": "lines 34-50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M's ruling changes the shape of every segment from here on: read a whole section, census its claims into two kinds, run exactly one computable and one prose instrument, bank both. A batch that runs over 200 s is split into two calls rather than trimmed of coverage."}, {"id": "recovered_handoff_34_computable_batch", "label": "The computable batch instrument", "file_type": "concept", "source_file": "recovered/HANDOFF-34.md", "source_location": "line 42", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_34_prose_batch", "label": "The prose batch instrument", "file_type": "concept", "source_file": "recovered/HANDOFF-34.md", "source_location": "line 43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instrument the census, do not hand-list it - a hand-list is a site list carried, and this project has found one short four times."}, {"id": "recovered_handoff_34_exact_set_cover_solver", "label": "Exact set-cover seed solver (r2-ch13h section 3)", "file_type": "concept", "source_file": "recovered/HANDOFF-34.md", "source_location": "line 42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every seed size sections 14.5.7 and 14.5.8 report came from one heuristic and the volume itself says they were wrong, so seeds are re-measured with the exact solver (envelope steps plus value slots as elements, two exact reductions, branch and bound) and never with prune-greedy."}, {"id": "recovered_handoff_34_handoff_33_retired_unused", "label": "HANDOFF-33 and BUILD108 retired unused", "file_type": "concept", "source_file": "recovered/HANDOFF-34.md", "source_location": "line 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They were presented before M's ruling arrived and their next-work section carries the retired cadence, so the handoff was rewritten in the same chat rather than amended."}], "edges": [{"source": "recovered_handoff_34_handoff_34", "target": "recovered_handoff_33_handoff_33", "relation": "references", "confidence": "AMBIGUOUS", "confidence_score": 0.2, "source_file": "recovered/HANDOFF-34.md", "source_location": "line 1 (supersedes HANDOFF-33)", "weight": 1.0}, {"source": "recovered_handoff_34_handoff_34", "target": "recovered_handoff_31_handoff_31", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "recovered/HANDOFF-34.md", "source_location": "line 3", "weight": 1.0}, {"source": "recovered_handoff_34_build109_compendia", "target": "recovered_handoff_31_build106_compendia", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "recovered/HANDOFF-34.md", "source_location": "line 3", "weight": 1.0}, {"source": "recovered_handoff_34_handoff_34", "target": "recovered_handoff_27_build90_main_bundle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/HANDOFF-34.md", "source_location": "line 3", "weight": 1.0}, {"source": "rec