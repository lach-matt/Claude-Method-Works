{"nodes": [{"id": "recovered_prediction_s87_item1b_floor_floor_on_s2", "label": "Floor on S'' (m~ = 2 S''_min / L^2)", "file_type": "rationale", "source_file": "recovered/PREDICTION-S87-ITEM1b-FLOOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "S''_min = min over [r_in,r_out] of r^2 rho_r is DERIVED from the field's own density rather than fitted; it gives a uniform convex floor under sigma~ so the tent extreme point applies to the remainder only. Filed and hashed before pack87/floor87.py existed, following the s87 Item 1 result that falsified S7 (tau3 is not small)."}, {"id": "recovered_prediction_s87_item1b_floor_jmax_certification", "label": "J_max < 2 certification criterion", "file_type": "rationale", "source_file": "recovered/PREDICTION-S87-ITEM1b-FLOOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A uniform floor RAISES J (convexity), so the threshold is explicitly NOT K < 1 + m~/2; it is J_tent(b0',b1') < 2 sqrt(1 - m~/2) computed numerically per channel. Stated to pre-empt the naive algebraic threshold."}, {"id": "recovered_prediction_s87_item1b_floor_tent_extreme_point", "label": "Tent extreme point (s85 theorem)", "file_type": "concept", "source_file": "recovered/PREDICTION-S87-ITEM1b-FLOOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "J convex in delta and delta affine in S makes the extreme point of the sigma' set a single delta of mass K' - so the worst case is a tent, not a search over profiles."}, {"id": "recovered_prediction_s87_item1b_floor_population_a", "label": "Population A (nu_rank 0,1; 74 channels, 50 with K>=1)", "file_type": "concept", "source_file": "recovered/PREDICTION-S87-ITEM1b-FLOOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s87_item1b_floor_five_uncertified_channels", "label": "The five J>=2 channels (Z=40 4d, 56 5d, 89 6d, 90 5f, 91 5f)", "file_type": "concept", "source_file": "recovered/PREDICTION-S87-ITEM1b-FLOOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filed as 0 of 5 certified: the bound cannot certify what is false, so these rows are the honest ceiling on any floor- or profile-based certification."}, {"id": "recovered_prediction_s87_item1b_floor_canfails", "label": "Can-fails CF1-CF4 (synthetic floor levers)", "file_type": "document", "source_file": "recovered/PREDICTION-S87-ITEM1b-FLOOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_prediction_s87_item1b_floor_jmax_certification", "target": "recovered_prediction_s87_item1b_floor_floor_on_s2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S87-ITEM1b-FLOOR.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s87_item1b_floor_floor_on_s2", "target": "recovered_prediction_s87_item1b_floor_tent_extreme_point", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S87-ITEM1b-FLOOR.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s87_item1b_floor_jmax_certification", "target": "recovered_prediction_s87_item1b_floor_population_a", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S87-ITEM1b-FLOOR.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s87_item1b_floor_five_uncertified_channels", "target": "recovered_prediction_s87_item1b_floor_jmax_certification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S87-ITEM1b-FLOOR.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s87_item1b_floor_canfails", "target": "recovered_prediction_s87_item1b_floor_floor_on_s2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S87-ITEM1b-FLOOR.md", "source_location": null, "weight": 1.0}], "hyperedges": []}