{"nodes": [{"id": "recovered_prediction_s84_item1_semiclassical_langer_phase_integral", "label": "Langer phase integral for the radial potential", "file_type": "rationale", "rationale": "With q(r) = -rV(r) and L = l + 1/2, pi*delta = Phi - Phi_Coulomb at the same E and L; differentiating in L^2 kills the turning-point terms and leaves dPhi/dL^2 = -(1/2) I with I = int dr/(r^2 p).", "source_file": "recovered/PREDICTION-S84-ITEM1-SEMICLASSICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s84_item1_semiclassical_anchor_theorem", "label": "The anchor theorem I = pi/L (exact, not approximate)", "file_type": "concept", "rationale": "Substituting u = 1/r turns I into the integral of an inverse square root of a quadratic between its own roots, giving pi/L for ANY constant charge and ANY bound E. Hence dg/dl = 2 - I/I_C and G-within holds iff I < 2 I_C.", "source_file": "recovered/PREDICTION-S84-ITEM1-SEMICLASSICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s84_item1_semiclassical_charge_blindness", "label": "Charge-blindness \u2014 the load-bearing half", "file_type": "concept", "rationale": "A field that is Coulombic anywhere, inner charge Z or outer charge 1, contributes exactly the hydrogenic amount, so the entire l-dependence of the defect comes from the region where q(r) is VARYING. That is what makes the variable-q region the whole story.", "source_file": "recovered/PREDICTION-S84-ITEM1-SEMICLASSICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s84_item1_semiclassical_semi84", "label": "pack84/semi84.py", "file_type": "concept", "source_file": "recovered/PREDICTION-S84-ITEM1-SEMICLASSICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s84_item1_semiclassical_exchange_localisation", "label": "Exchange localisation X/P is a declared approximation", "file_type": "concept", "rationale": "HF exchange is non-local; the instrument localises it as X/P to form q(r), so any claim is conditional on that localisation, and the measured tail value is reported so it can be checked against q_eff = 1.000000.", "source_file": "recovered/PREDICTION-S84-ITEM1-SEMICLASSICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s84_item1_semiclassical_fixed_e_limitation", "label": "Declared limitation: dg/dl at fixed E vs frontier channels differing in n", "file_type": "rationale", "rationale": "The two width-2 frontier channels differ in n as well as l, so the comparison mixes the l-derivative with an energy shift; a disagreement at one row is evidence about the comparison, not necessarily about the identity (F82.2's shape, declared before the run).", "source_file": "recovered/PREDICTION-S84-ITEM1-SEMICLASSICAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_prediction_s84_item1_semiclassical_langer_phase_integral", "target": "recovered_prediction_s84_item1_semiclassical_anchor_theorem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S84-ITEM1-SEMICLASSICAL.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s84_item1_semiclassical_anchor_theorem", "target": "recovered_prediction_s84_item1_semiclassical_charge_blindness", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S84-ITEM1-SEMICLASSICAL.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s84_item1_semiclassical_langer_phase_integral", "target": "recovered_prediction_s83_item1_gladder_g_within", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S84-ITEM1-SEMICLASSICAL.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s84_item1_semiclassical_semi84", "target": "recovered_prediction_s84_item1_semiclassical_anchor_theorem", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S84-ITEM1-SEMICLASSICAL.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s84_item1_semiclassical_exchange_localisation", "target": "recovered_prediction_s84_item1_semiclassical_semi84", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S84-ITEM1-SEMICLASSICAL.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s84_item1_semiclassical_fixed_e_limitation", "target": "recovered_prediction_s83_item1b_frontier_frontier_width", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S84-ITEM1-SEMICLASSICAL.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s84_item1_semiclassical_charge_blindness", "target": "recovered_prediction_s79_item1_fixedfield_f_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S84-ITEM1-SEMICLASSICAL.md", "source_location": null, "weight": 1.0}], "hyperedges": []}