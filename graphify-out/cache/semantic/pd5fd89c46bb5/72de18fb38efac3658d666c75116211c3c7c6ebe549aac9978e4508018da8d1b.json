{"nodes": [{"id": "recovered_prediction_s79_item1_fixedfield_fixed_field_comparison", "label": "Fixed-field cross-channel comparison at Z=89", "file_type": "rationale", "rationale": "Freeze the core at the converged 6d solution Phi_d*, build F_core = h + sum(J_i - K_i) from the frozen core orbitals, and compare eps_3^{l=3} against eps_4^{l=2} in ONE field. Item 2 gave three different self-consistent fields; this is the first time the fixed-field object is computed.", "source_file": "recovered/PREDICTION-S79-ITEM1-FIXEDFIELD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s79_item1_fixedfield_f_core", "label": "F_core \u2014 the frozen-core Fock operator", "file_type": "concept", "source_file": "recovered/PREDICTION-S79-ITEM1-FIXEDFIELD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s79_item1_fixedfield_madelung_ordering", "label": "Madelung ordering holds at fixed field (clause 1's special case)", "file_type": "concept", "source_file": "recovered/PREDICTION-S79-ITEM1-FIXEDFIELD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s79_item1_fixedfield_control_4f", "label": "The 4f control that must return ORDERING FAILS", "file_type": "concept", "rationale": "4f lies deep inside the [Rn] core and far below 6d, so the comparator must be able to return the f-above-d comparison failing. The control runs first; if it returns the ordering holding, the instrument is broken and the run is void.", "source_file": "recovered/PREDICTION-S79-ITEM1-FIXEDFIELD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s79_item1_fixedfield_ceff_zero", "label": "_ceff(a,Q) = Q[a] - 1 vanishes at single occupancy", "file_type": "concept", "ratio