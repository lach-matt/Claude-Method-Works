{"nodes": [{"id": "extracted_projects_the_method_books_builder_genesis_register_1_to_94_genesis_register_block", "label": "Genesis Register (entries 1-94)", "file_type": "document", "source_file": "extracted/projects/the-method-books-builder/GENESIS-REGISTER-1-to-94.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The genesis block is 94 genuine subject-matter events, not 164; author's rule was not to pad or trim to reach 164."}, {"id": "extracted_projects_the_method_books_builder_genesis_register_1_to_94_origin_at_smallest_measurable_step", "label": "Origin as Smallest Measurable Step, Not Zero", "file_type": "rationale", "source_file": "extracted/projects/the-method-books-builder/GENESIS-REGISTER-1-to-94.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "True zero represents absence of any element and is reserved as an unoccupied vacuum point, so hydrogen anchors at the smallest measurable coordinate on all three axes; echoes zero-point energy."}, {"id": "extracted_projects_the_method_books_builder_genesis_register_1_to_94_three_axis_configuration_lattice", "label": "Three-Axis Configuration Lattice (n, l, k)", "file_type": "concept", "source_file": "extracted/projects/the-method-books-builder/GENESIS-REGISTER-1-to-94.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What the conventional table conflates into one positional axis is separated into three; no new physics, only a change of coordinates."}, {"id": "extracted_projects_the_method_books_builder_genesis_register_1_to_94_admissible_lattice_lambda", "label": "The Admissible Lattice Lambda", "file_type": "concept", "source_file": "extracted/projects/the-method-books-builder/GENESIS-REGISTER-1-to-94.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two constraints only: the angular-momentum condition l <= n-1 and the Pauli capacity 2(2l+1); the g layer is carried as a theoretical extension."}, {"id": "extracted_projects_the_method_books_builder_genesis_register_1_to_94_empty_space_partition", "label": "Void / Reactive / Reserved Partition of Empty Space", "file_type": "concept", "source_file": "extracted/projects/the-method-books-builder/GENESIS-REGISTER-1-to-94.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The periodic table has no vocabulary for absence; the coordinate change supplies one."}, {"id": "extracted_projects_the_method_books_builder_genesis_register_1_to_94_census_630_cell_lattice", "label": "Census of the 630-Cell Lattice", "file_type": "concept", "source_file": "extracted/projects/the-method-books-builder/GENESIS-REGISTER-1-to-94.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "180 void, 240 reactive, 92 reserved, 118 occupied; void and reactive together are two-thirds of the volume."}, {"id": "extracted_projects_the_method_books_builder_genesis_register_1_to_94_ghost_5g_cells", "label": "The 14 Ghost 5g Cells", "file_type": "concept", "source_file": "extracted/projects/the-method-books-builder/GENESIS-REGISTER-1-to-94.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First-draft state carried 14 fifth-shell 5g cells as occupied-adjacent with 78 reserved; the paper folds the ghosts into the reserved count and recounts."}, {"id": "extracted_projects_the_method_books_builder_genesis_register_1_to_94_field_equation_theorem", "label": "The Field Equation Theorem", "file_type": "concept", "source_file": "extracted/projects/the-method-books-builder/GENESIS-REGISTER-1-to-94.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Founding claim that an element's spatial range is quantifiable from lattice coordinates alone."}, {"id": "extracted_projects_the_method_books_builder_genesis_register_1_to_94_bounded_search_claim_withdrawn", "label": "Bounded-Search Claim, Withdrawn", "file_type": "rationale", "source_file": "extracted/projects/the-method-books-builder/GENESIS-REGISTER-1-to-94.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Withdrawn in the paper as overstating what valence configuration can constrain; recorded in its original strong form rather than deleted."}, {"id": "extracted_projects_the_method_books_builder_genesis_register_1_to_94_dimensional_obstruction", "label": "Lambda in N^3 - the Dimensional Obstruction", "file_type": "concept", "source_file": "extracted/projects/the-method-books-builder/GENESIS-REGISTER-1-to-94.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The first 'a null needs a different language' event in the whole arc; the axes are counts, not lengths, and are coupled."}, {"id": "extracted_projects_the_method_books_builder_genesis_register_1_to_94_order_ideal", "label": "The Order Ideal (registers 66-69)", "file_type": "concept", "source_file": "extracted/projects/the-method-books-builder/GENESIS-REGISTER-1-to-94.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Load-bearing genesis result on the lattice as an ordered set."}], "edges": [{"source": "extracted_projects_the_method_books_builder_genesis_register_1_to_94_genesis_register_block", "target": "extracted_projects_the_method_books_builder_genesis_register_1_to_94_three_axis_configuration_lattice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/projects/the-method-books-builder/GENESIS-REGISTER-1-to-94.md