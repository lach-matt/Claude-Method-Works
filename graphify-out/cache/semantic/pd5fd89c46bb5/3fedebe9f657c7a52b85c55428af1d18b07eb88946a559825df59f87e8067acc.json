{"nodes": [{"id": "extracted_archives_method16_rp_b_data_tablei_ame2020_table_i", "label": "AME2020 Table I \u2014 The 2020 Atomic Mass Table", "file_type": "document", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "lines 1-4759 (whole file)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A verbatim plain-text capture of the published AME2020 Table I: 70 journal pages (030003-6 through 030003-75) of fixed-width columns holding 3,558 nuclide rows, Z from 0 (the free neutron) to 118 (Og), A from 1 to 295, 119 distinct element symbols. It is the reference mass/binding-energy table the corpus measures its occupation and shell claims against, held as text rather than as a table file so that column positions, footnote letters and the '#' extrapolation marks survive byte-exact."}, {"id": "extracted_archives_method16_rp_b_data_tablei_ame2020_mass_evaluation", "label": "AME2020 Atomic Mass Evaluation", "file_type": "paper", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "table caption, repeated on every page", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The evaluation whose output this table is. Values are not single measurements but least-squares adjusted masses, which is why every data column carries its own uncertainty column and why an 'Orig.' flag records where a value came from."}, {"id": "extracted_archives_method16_rp_b_data_tablei_chinese_physics_c_45_3_030003", "label": "Chinese Physics C Vol. 45, No. 3 (2021) 030003", "file_type": "paper", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "running head, 70 occurrences", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The publication of record. The running head and the page footers (030003-6 \u2026 030003-75) are the only provenance this capture carries, and they are preserved in-line rather than stripped, so any row can be cited back to its printed page."}, {"id": "extracted_archives_method16_rp_b_data_tablei_explanation_of_table", "label": "Explanation of Table (p. 030003-5)", "file_type": "document", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "caption: \"Explanation of Table on p. 030003-5\"", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The caption points at an explanation page that is NOT in this capture \u2014 the file begins at 030003-6. So the meaning of the 'Orig.' codes, the footnote letter 'a' and the '#' mark is cited here but held nowhere in this file; a reader who needs the legend must go to the publication."}, {"id": "extracted_archives_method16_rp_b_data_tablei_nuclide", "label": "Nuclide (the indexed entity, one per row)", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "every data line", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A row is one nuclide, keyed by (N, Z). The table is blocked by mass number A: only the first row of an isobaric block prints A, and subsequent rows of the same A leave the column blank, so a row cannot be read in isolation \u2014 A is inherited from the block head. Blank lines separate isobaric blocks."}, {"id": "extracted_archives_method16_rp_b_data_tablei_neutron_number_n", "label": "N \u2014 neutron number (column 1)", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "column header row", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "extracted_archives_method16_rp_b_data_tablei_proton_number_z", "label": "Z \u2014 proton number (column 2)", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "column header row", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs 0 to 118. Z = 0 is a real row \u2014 the free neutron \u2014 so any consumer that treats Z as an element index must special-case it."}, {"id": "extracted_archives_method16_rp_b_data_tablei_mass_number_a", "label": "A \u2014 mass number (column 3, block key)", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "column header row", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Printed only on the first row of each isobaric block; spans A = 1 to A = 295. It is the table's ordering key, not a per-row field."}, {"id": "extracted_archives_method16_rp_b_data_tablei_element_symbol", "label": "Elt. \u2014 element symbol (column 4)", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "column header row", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "119 distinct symbols appear, one more than the 118 elements, because the neutron row carries no symbol in some printings and the set spans H through Og."}, {"id": "extracted_archives_method16_rp_b_data_tablei_mass_excess_kev", "label": "Mass excess (keV)", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "column header row, columns 6-7 (value, uncertainty)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M \u2212 A in energy units; signed, and the only column whose sign flips across the table (positive at both ends of the mass range, negative through the iron-to-lead region). Quoted with its own uncertainty."}, {"id": "extracted_archives_method16_rp_b_data_tablei_binding_energy_per_nucleon_kev", "label": "Binding energy per nucleon (keV)", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "column header row, columns 8-9 (value, uncertainty)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "B/A, not B \u2014 the division is already done in the table, so a consumer wanting total binding energy must multiply by A, which is the blocked column that may be blank on the row."}, {"id": "extracted_archives_method16_rp_b_data_tablei_beta_decay_energy_kev", "label": "Beta-decay energy (keV)", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "column header row, columns 10-12 (mode, value, uncertainty)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A compound column: a decay-mode token (\u03b2\u2212 or \u03b2+) precedes the energy, and the energy may be negative (an endothermic channel). Where no beta energy is given the field holds a bare asterisk, so the column is not numerically typed."}, {"id": "extracted_archives_method16_rp_b_data_tablei_atomic_mass_microu", "label": "Atomic mass (\u00b5u)", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "column header row, final two columns", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Printed in micro-atomic-mass-units with an internal space splitting the integer part from the fraction (\"1 008664.9159\"), i.e. A followed by the \u00b5u remainder. Whitespace-splitting a row therefore yields one token too many unless the gap is rejoined \u2014 the single most likely parse fault in this file."}, {"id": "extracted_archives_method16_rp_b_data_tablei_uncertainty_column", "label": "Per-quantity uncertainty columns", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "interleaved after each of the four value columns", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every measured quantity carries its own uncertainty immediately to its right. A lone footnote letter 'a' sometimes stands where a number would, marking a value whose uncertainty is given by a footnote rather than inline \u2014 an uncertainty field is thus not reliably numeric."}, {"id": "extracted_archives_method16_rp_b_data_tablei_extrapolation_marker", "label": "'#' extrapolation marker", "file_type": "rationale", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "8,074 occurrences across the file", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A trailing '#' on a value or an uncertainty marks it as estimated from systematic trends rather than measured. 8,074 of them appear, so a large fraction of the table is extrapolated and NOT experimental; stripping the '#' to coerce a float silently promotes an estimate to a measurement. The mark is attached to the number itself, not carried in a separate flag column."}, {"id": "extracted_archives_method16_rp_b_data_tablei_stability_asterisk", "label": "'*' in the beta-decay-energy field", "file_type": "rationale", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "beta-decay-energy column, e.g. the 1H, 4He and 138Ba rows", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stands where a mode and an energy would be, marking a nuclide for which no beta-decay energy is tabulated. It is an absence of a tabulated channel, not a claim of stability, and must not be read as zero."}, {"id": "extracted_archives_method16_rp_b_data_tablei_origin_flag", "label": "Orig. \u2014 origin-of-value flag (column 5)", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "column header row; populated on 2,338 rows", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small optional vocabulary recording how a mass was obtained or related to a neighbour: 'x' (1,336 rows) dominates, then '\u2212\u03b1' (522), '\u2212' (101), '-n' (87), '+' (67), '+\u03b1' (51), '-p' (43), '-nn' (28), 'IT' (25), down to single-occurrence codes like 'p4n', '+n2p' and 'ea'. The legend for these sits on the explanation page, which this capture does not include \u2014 so the codes are present and their meanings are not."}, {"id": "extracted_archives_method16_rp_b_data_tablei_beta_minus_decay", "label": "\u03b2\u2212 decay channel", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "beta-decay-energy column, mode token", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "extracted_archives_method16_rp_b_data_tablei_beta_plus_decay", "label": "\u03b2+ decay channel", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "beta-decay-energy column, mode token", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "extracted_archives_method16_rp_b_data_tablei_alpha_origin_code", "label": "\u2212\u03b1 / +\u03b1 origin codes", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "Orig. column; 522 '\u2212\u03b1' and 51 '+\u03b1' rows", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An alpha-linked value: the mass is tied to a neighbour four mass units away rather than measured directly. These dominate the superheavy end of the table, where nearly every row is both \u03b1-linked and '#'-extrapolated."}, {"id": "extracted_archives_method16_rp_b_data_tablei_isomeric_transition_it", "label": "IT \u2014 isomeric transition origin code", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "Orig. column; 25 rows", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "extracted_archives_method16_rp_b_data_tablei_nucleon_transfer_origin_codes", "label": "Nucleon-transfer origin codes (-n, -p, -nn, -pp, p\u22122n, p4n, \u03b5p \u2026)", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "Orig. column; ~230 rows across roughly 20 distinct codes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A long tail of composite codes naming the nucleons separating a value from the neighbour it was derived through. Many occur once or twice, so a parser that enumerates the vocabulary from a sample will miss codes; the set must be read from the whole column."}, {"id": "extracted_archives_method16_rp_b_data_tablei_free_neutron_row", "label": "Free-neutron row (N=1, Z=0, A=1)", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "first data line", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The table opens with the neutron: mass excess 8071.3181 keV, binding energy per nucleon 0.0, \u03b2\u2212 energy 782.347 keV, atomic mass 1 008664.9159 \u00b5u. It is the zero-point of the whole adjustment and the one row with Z = 0."}, {"id": "extracted_archives_method16_rp_b_data_tablei_superheavy_extrapolated_region", "label": "Superheavy extrapolated region (Z 104-118, A up to 295)", "file_type": "concept", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "final pages, 030003-74 and 030003-75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The table ends at 295Og with every value on the last pages carrying '#' and most carrying an \u03b1-link origin. Nothing there is a measurement \u2014 it is the systematic-trend frontier, and treating the tail as data of the same standing as the 4He row is the characteristic misuse of this file."}, {"id": "extracted_archives_method16_rp_b_data_tablei_page_pagination_artefacts", "label": "Retained pagination artefacts (running heads, footers, repeated column headers)", "file_type": "rationale", "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "70 running heads, 70 footers 030003-6 \u2026 030003-75, 70 repeated header blocks", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The capture keeps the print furniture rather than concatenating the data: each page repeats the journal head, the caption (with '(continued)' from the second page on), the column-header pair and a page footer. That preserves citability per printed page, at the cost that 4,759 lines hold only 3,558 data rows \u2014 a reader must filter, and a naive line count overstates the table by roughly a third."}], "edges": [{"source": "extracted_archives_method16_rp_b_data_tablei_ame2020_table_i", "target": "extracted_archives_method16_rp_b_data_tablei_chinese_physics_c_45_3_030003", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "running head on every page", "weight": 1.0}, {"source": "extracted_archives_method16_rp_b_data_tablei_ame2020_table_i", "target": "extracted_archives_method16_rp_b_data_tablei_explanation_of_table", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "caption: \"Explanation of Table on p. 030003-5\"", "weight": 1.0}, {"source": "extracted_archives_method16_rp_b_data_tablei_ame2020_table_i", "target": "extracted_archives_method16_rp_b_data_tablei_ame2020_mass_evaluation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "caption: \"The 2020 Atomic mass table\"", "weight": 1.0}, {"source": "extracted_archives_method16_rp_b_data_tablei_ame2020_table_i", "target": "extracted_archives_method16_rp_b_data_tablei_nuclide", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "3,558 data rows", "weight": 1.0}, {"source": "extracted_archives_method16_rp_b_data_tablei_nuclide", "target": "extracted_archives_method16_rp_b_data_tablei_neutron_number_n", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "column 1 of every row", "weight": 1.0}, {"source": "extracted_archives_method16_rp_b_data_tablei_nuclide", "target": "extracted_archives_method16_rp_b_data_tablei_proton_number_z", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "column 2 of every row", "weight": 1.0}, {"source": "extracted_archives_method16_rp_b_data_tablei_nuclide", "target": "extracted_archives_method16_rp_b_data_tablei_mass_number_a", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "column 3, printed once per isobaric block", "weight": 1.0}, {"source": "extracted_archives_method16_rp_b_data_tablei_nuclide", "target": "extracted_archives_method16_rp_b_data_tablei_element_symbol", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "column 4 of every row", "weight": 1.0}, {"source": "extracted_archives_method16_rp_b_data_tablei_nuclide", "target": "extracted_archives_method16_rp_b_data_tablei_mass_excess_kev", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "value column 1", "weight": 1.0}, {"source": "extracted_archives_method16_rp_b_data_tablei_nuclide", "target": "extracted_archives_method16_rp_b_data_tablei_binding_energy_per_nucleon_kev", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "value column 2", "weight": 1.0}, {"source": "extracted_archives_method16_rp_b_data_tablei_nuclide", "target": "extracted_archives_method16_rp_b_data_tablei_beta_decay_energy_kev", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "value column 3", "weight": 1.0}, {"source": "extracted_archives_method16_rp_b_data_tablei_nuclide", "target": "extracted_archives_method16_rp_b_data_tablei_atomic_mass_microu", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "value column 4", "weight": 1.0}, {"source": "extracted_archives_method16_rp_b_data_tablei_nuclide", "target": "extracted_archives_method16_rp_b_data_tablei_origin_flag", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "column 5, optional", "weight": 1.0}, {"source": "extracted_archives_method16_rp_b_data_tablei_uncertainty_column", "target": "extracted_archives_method16_rp_b_data_tablei_mass_excess_kev", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/method16-rp-b-data/tableI.txt", "source_location": "paired value/uncertainty layout", "weight": 1.0}, {"source": "extracted_archives_method16_rp_b_data_tablei_uncertainty_column", "target": "extract