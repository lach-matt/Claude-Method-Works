ences", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "weight": 1.0}, {"source": "extracted_archives_restore_point_2_13_captures_urls_supplied_three_failure_modes", "target": "extracted_archives_restore_point_2_13_captures_fetch_batched_semicolon_list_form", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "weight": 1.0}, {"source": "extracted_archives_restore_point_2_13_captures_urls_supplied_supplied_is_not_returned", "target": "extracted_archives_restore_point_2_13_bridge_raw_1411_1420_register_1414", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "nist_fetch_block_investigation", "label": "The NIST ASD fetch-block investigation (registers 1595, 1629\u20131636)", "nodes": ["extracted_archives_restore_point_2_13_captures_urls_supplied_no_cache_one_permission_layer", "extracted_archives_restore_point_2_13_captures_urls_supplied_three_failure_modes", "extracted_archives_restore_point_2_13_captures_urls_supplied_parameter_sets_by_endpoint", "extracted_archives_restore_point_2_13_captures_fetch_batched_semicolon_list_form", "extracted_archives_restore_point_2_13_captures_fetch_neutrals_no_stage_suffix_rule", "extracted_archives_restore_point_2_13_captures_fetch_queue_minimal_url_form"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md"}]}