{"nodes": [{"id": "extracted_archives_restore_point_2_13_captures_urls_supplied_urls_supplied", "label": "URLs M has supplied (register 1595)", "file_type": "document", "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Written to correct a claim at register 1594 that the ladder needed a URL from M: M had already supplied them and they were recoverable from the transcripts. The block is the fetch cache, not a missing address."}, {"id": "extracted_archives_restore_point_2_13_captures_urls_supplied_ie_pl_endpoint", "label": "NIST ASD ie.pl endpoint", "file_type": "concept", "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "extracted_archives_restore_point_2_13_captures_urls_supplied_energy1_pl_endpoint", "label": "NIST ASD energy1.pl endpoint", "file_type": "concept", "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "extracted_archives_restore_point_2_13_captures_urls_supplied_sremoval_parameter", "label": "sremoval=on \u2014 the multi-charge ladder parameter", "file_type": "concept", "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "extracted_archives_restore_point_2_13_captures_urls_supplied_ladder_k_kr_tsv", "label": "LADDER-K-Kr.tsv (495 rows across every ionisation stage)", "file_type": "document", "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "extracted_archives_restore_point_2_13_captures_urls_supplied_one_response_per_session", "label": "One response per session, whatever is asked", "file_type": "rationale", "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Register 1526's rule sharpened: the cache is pinned per host+path, so varying the query string does not move it. Superseded within the same file by the R 1629 correction that there is no cache at all."}, {"id": "extracted_archives_restore_point_2_13_captures_urls_supplied_no_cache_one_permission_layer", "label": "There is no cache \u2014 one permission layer, two exits", "file_type": "rationale", "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The three identical ie.pl bodies were not a stale cache: only one such URL had ever appeared in a result, so only one body was ever available to serve. The refusal is the safer exit \u2014 it cannot be mistaken for a result, whereas being served a different URL's body can, and at R 1595 it nearly was."}, {"id": "extracted_archives_restore_point_2_13_captures_urls_supplied_three_failure_modes", "label": "Three failure modes of a constructed URL", "file_type": "rationale", "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never in a result means refused; constructed near a permitted one means the permitted body is served instead; longer than ~230 characters means refused for size. The exact limit was not probed because finding it would cost fetches better spent on data."}, {"id": "extracted_archives_restore_point_2_13_captures_urls_supplied_supplied_is_not_returned", "label": "A URL that was supplied is not a URL that returned data", "file_type": "rationale", "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The energy1.pl form was an untested reconstruction later called the only one that had ever worked \u2014 the distinction has to be read back out of the transcripts."}, {"id": "extracted_archives_restore_point_2_13_captures_urls_supplied_parameter_sets_by_endpoint", "label": "The parameter sets differ by endpoint (R 1635)", "file_type": "concept", "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "order=0 is ie.pl's; energy1.pl rejects it with 'Unknown parameter' and does not say which one. Four fetches were spent on that name, which is why the sets are now tabulated rather than assumed shared."}], "edges": [{"source": "extracted_archives_restore_point_2_13_captures_urls_supplied_urls_supplied", "target": "extracted_archives_restore_point_2_13_captures_urls_supplied_ie_pl_endpoint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "weight": 1.0}, {"source": "extracted_archives_restore_point_2_13_captures_urls_supplied_urls_supplied", "target": "extracted_archives_restore_point_2_13_captures_urls_supplied_energy1_pl_endpoint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "extracted/archives/restore-point-2-13/captures/URLS-SUPPLIED.md", "source_location": null, "weight": 1.0}, {"source": "extracted_archives_restore_point_2_13_captures_urls_supplied_sremoval_parameter", "target": "extracted_archives_restore_point_2_13_captures_urls_supplied_ie_pl_endpoint", "relatio