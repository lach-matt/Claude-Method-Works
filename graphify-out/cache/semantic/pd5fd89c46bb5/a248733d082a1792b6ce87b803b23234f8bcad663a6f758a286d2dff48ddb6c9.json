{"nodes": [{"id": "_github_workflows_drive_sync_drive_sync_workflow", "label": "Drive sync workflow", "file_type": "code", "source_file": ".github/workflows/drive-sync.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dispatch-only by default with dry_run ticked; the schedule block ships commented out because a scheduled run is never a dry run and commits large binaries unreviewed."}, {"id": "_github_workflows_drive_sync_oauth_secrets_guard", "label": "Google OAuth secrets presence guard", "file_type": "code", "source_file": ".github/workflows/drive-sync.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "secrets are unavailable in an if:, so presence is tested inside a step that publishes a true/false output; missing secrets exit 0 with an explanation rather than a red X."}, {"id": "_github_workflows_drive_sync_token_json_assembly", "label": "token.json assembled from three secrets", "file_type": "code", "source_file": ".github/workflows/drive-sync.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writing token null with no expiry makes google-auth load the credential as expired, which is the branch that refreshes instead of opening a browser, so CI never needs interactive consent."}, {"id": "_github_workflows_drive_sync_size_guard", "label": "Refuse to commit anything GitHub would reject", "file_type": "code", "source_file": ".github/workflows/drive-sync.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catches a file over 99M before the commit rather than at push time, because the 100 MiB limit applies to the blob anywhere in history."}, {"id": "_github_workflows_drive_sync_no_prune", "label": "Never passes --prune", "file_type": "rationale", "source_file": ".github/workflows/drive-sync.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drive deletions are reported in the job log and not applied, so a scheduled job can never delete committed files without review."}, {"id": "_github_workflows_drive_sync_testing_token_expiry", "label": "Testing-status OAuth apps expire refresh tokens in 7 days", "file_type": "rationale", "source_file": ".github/workflows/drive-sync.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A scheduled job starts failing about a week after the secret is created unless the app is published or the token re-minted weekly."}], "edges": [{"source": "_github_workflows_drive_sync_drive_sync_workflow", "target": "docs_drive_sync_drive_sync_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/drive-sync.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_drive_sync_oauth_secrets_guard", "target": "_github_workflows_drive_sync_drive_sync_workflow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/drive-sync.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_drive_sync_token_json_assembly", "target": "_github_workflows_drive_sync_drive_sync_workflow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/drive-sync.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_drive_sync_token_json_assembly", "target": "docs_drive_sync_colab_mount", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/drive-sync.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_drive_sync_size_guard", "target": "docs_repo_size_github_limits", "relation": 