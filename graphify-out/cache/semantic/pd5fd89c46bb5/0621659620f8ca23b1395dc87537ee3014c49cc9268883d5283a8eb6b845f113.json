{"nodes": [{"id": "recovered_reclass_r1449_s19_pm1_session_20_reclassification_r1449", "label": "Reclassification per the R 1449 convention (session 20)", "file_type": "document", "source_file": "recovered/RECLASS-R1449-S19-PM1-SESSION-20.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filed as a reclassification, not a fault of session 19: scoring centroid objects against level measurements was correct at the time, and the structural claim is not withdrawn."}, {"id": "recovered_reclass_r1449_s19_pm1_session_20_centroid_versus_level_measurement", "label": "Centroid objects versus level measurements", "file_type": "concept", "source_file": "recovered/RECLASS-R1449-S19-PM1-SESSION-20.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The measurement is level-to-level and the ion's 4f-hole level is the spin-orbit-lowered top of an inverted multiplet, so a centroid score and a level score are different quantities."}, {"id": "recovered_reclass_r1449_s19_pm1_session_20_yb_zero_accidental", "label": "Yb 0 -> 0 % was accidental to the coupling constant", "file_type": "concept", "source_file": "recovered/RECLASS-R1449-S19-PM1-SESSION-20.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A coincidence at one value is not agreement, so the figure is recorded as accidental rather than quoted as a hit."}], "edges": [{"source": "recovered_reclass_r1449_s19_pm1_session_20_reclassification_r1449", "target": "recovered_reclass_r1449_s19_pm1_session_20_centroid_versus_level_measurement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/RECLASS-R1449-S19-PM1-SESSION-20.md", "source_location": null, "weight": 1.0}, {"source": "recovered_reclass_r1449_s19_pm1_session_20_reclassification_r1449", "target": "recovered_recla