{"nodes": [{"id": "recovered_prediction_s80_item2_oc1_oc1_falsifier", "label": "O-C1's falsifier \u2014 is the converged basin unique?", "file_type": "rationale", "rationale": "Converge Z=89 cfg88+6d to E*, perturb the converged orbitals, re-converge, and ask whether the field returns. A second basin at lower energy kills the adopted Step 0(ii) rule as stated. Filed in advance: this test can only ever KILL the rule, never establish it.", "source_file": "recovered/PREDICTION-S80-ITEM2-OC1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s80_item2_oc1_perturb80", "label": "pack80/perturb80.py", "file_type": "concept", "source_file": "recovered/PREDICTION-S80-ITEM2-OC1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s80_item2_oc1_weak_evidence_declared", "label": "Weak evidence declared in advance of a null", "file_type": "rationale", "rationale": "A local perturbation is a weaker displacement than the four-seed evidence that started 52 Ha away, so the test is expected to confirm weakly; the judgement is filed first so a null cannot later be quoted as strong.", "source_file": "recovered/PREDICTION-S80-ITEM2-OC1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s80_item2_oc1_node_failure_not_basin_evidence", "label": "A node-count failure is not basin evidence", "file_type": "concept", "rationale": "At amp >= 0.3 a heavily contaminated orbital has the wrong node count by construction and hfc2.run2 raises before recovery; that is the instrument failing to deliver its intended starting point, not a statement about basins.", "source_file": "recovered/PREDICTION-S80-ITEM2-OC1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_s80_item2_oc1_mix_vs_noise", "label": "'mix' is the more severe perturbation at equal amplitude", "file_type": "concept", "rationale": "Noise is isotropic and largely orthogonal to the low-lying directions; mix is deliberately aligned with the nearest same-l shell, which is where an RHF instability would lie.", "source_file": "recovered/PREDICTION-S80-ITEM2-OC1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_prediction_s80_item2_oc1_perturb80", "target": "recovered_prediction_s80_item2_oc1_oc1_falsifier", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S80-ITEM2-OC1.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s80_item2_oc1_weak_evidence_declared", "target": "recovered_prediction_s80_item2_oc1_oc1_falsifier", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S80-ITEM2-OC1.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s80_item2_oc1_node_failure_not_basin_evidence", "target": "recovered_prediction_s80_item2_oc1_oc1_falsifier", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S80-ITEM2-OC1.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s80_item2_oc1_mix_vs_noise", "target": "recovered_prediction_s80_item2_oc1_perturb80", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S80-ITEM2-OC1.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s80_item2_oc1_oc1_falsifier", "target": "recovered_prediction_s78_item2_seedd_seed_d", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S80-ITEM2-OC1.md", "source_location": null, "weight": 1.0