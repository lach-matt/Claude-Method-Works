{"nodes": [{"id": "recovered_prediction_nlwalk_session_36_prediction_nlwalk_s36", "label": "PREDICTION-NLWALK (session 36): the full-table n+l walk", "file_type": "document", "source_file": "recovered/PREDICTION-NLWALK-SESSION-36.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_nlwalk_session_36_nlwalk_py", "label": "nlwalk.py", "file_type": "concept", "source_file": "recovered/PREDICTION-NLWALK-SESSION-36.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_nlwalk_session_36_zeno_staging", "label": "Zeno staging: Stage 1 local non-rel field, Stage 2 HF frozen, Stage 3 SR local (owed if budget ends)", "file_type": "rationale", "source_file": "recovered/PREDICTION-NLWALK-SESSION-36.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Staged so a partial session still yields a scorable result, and the SIC-convention comparison is deferred to Stage 3 rather than mixed in."}, {"id": "recovered_prediction_nlwalk_session_36_channel_rule_per_row", "label": "Channel rule: (N,0), (N,1), (N-1,2) and (N-2,3) if N-2>=4, entrant from ground.expand", "file_type": "rationale", "source_file": "recovered/PREDICTION-NLWALK-SESSION-36.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Channels are enumerated from the record rather than searched, so no scan can find a favourable channel."}, {"id": "recovered_prediction_nlwalk_session_36_f_collapse_local_field_fault", "label": "PN2/PN3: the local frozen and relaxed field put the f channel deepest \u2014 the local 4f/5f fault", "file_type": "rationale", "source_file": "recovered/PREDICTION-NLWALK-SESSION-36.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Where the local field misorders a d/s frontier relaxation restores the recorded entrant, but on f frontiers it does not; that asymmetry is named as a fault of the local field rather than of the walk."}, {"id": "recovered_prediction_nlwalk_session_36_post_hoc_slot_empty_by_design", "label": "PN6: a post-hoc slot left empty by design", "file_type": "rationale", "source_file": "recovered/PREDICTION-NLWALK-SESSION-36.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The other mechanism is not to be read from these numbers until the record read is done; under R 1449 any design change after seeing a result gets a timing flag."}], "edges": [{"source": "recovered_prediction_nlwalk_session_36_prediction_nlwalk_s36", "target": "recovered_prediction_nlwalk_session_36_nlwalk_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-NLWALK-SESSION-36.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_nlwalk_session_36_prediction_nlwalk_s36", "target": "recovered_prediction_nlwalk_session_36_zeno_staging", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-NLWALK-SESSION-36.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_nlwalk_session_36_nlwalk_py", "target": "recovered_prediction_nlwalk_session_36_channel_rule_per_row", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-NLWALK-SESSION-36.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_nlwalk_session_36_prediction_nlwalk_s36", "target": "recovered_prediction_nlwalk_session_36_f_collapse_local_field_fault", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-NLWALK-SESSION-36.md", "source_location": null, "weight": 1.0}, {"s