{"nodes": [{"id": "recovered_session_81_combined_handoff", "label": "Session 81 Combined Handoff", "file_type": "document", "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_session_81_combined_fixed81", "label": "fixed81.py (Z=90 Fixed-Field Probe)", "file_type": "concept", "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fixed79 patched rather than reused: E6 reduces the entrant's occupancy by one instead of deleting the shell, which would have run a 90-electron atom with 89."}, {"id": "recovered_session_81_combined_de81", "label": "de81.py (Bracket Search at 7d and 8d)", "file_type": "concept", "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_session_81_combined_z90_fixed_field", "label": "Z=90 Fixed-Field Comparison: Relaxation Exceeds the Gap", "file_type": "concept", "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At thorium the relaxation term is 89.901 mHa against a 79.244 mHa gap - 113%, where at Z=89 it was 6.5%. s79's 10.1 mHa target is a Z=89 figure and does not travel; the flag s79 attached to it was load-bearing and is discharged against it."}, {"id": "recovered_session_81_combined_j2_restart_both_sides", "label": "J2: Restart Both Sides, Not One", "file_type": "concept", "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restarting reference and perturbed run alike shrinks the scatter 17x, from a 0.023487 mHa landing range to a 0.001414 mHa stationary range, and every run lands above the reference. The null's floor falls from ~0.035 to ~0.0015 mHa."}, {"id": "recovered_session_81_combined_r81_2", "label": "R81.2 - J2 Is Standing Law", "file_type": "concept", "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_session_81_combined_r81_6", "label": "R81.6 - 7d/8d Stay Class B Until Confirmed at the Converged Field", "file_type": "concept", "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M refused to promote a refusal measured at the fallback iteration into a finding about the converged field; the confirmation is made OWED instead. Made before F82.2 was known, it is what kept the fault out of the record."}, {"id": "recovered_session_81_combined_f81_1", "label": "F81.1 The Restart Ladder Is Not a Descent", "file_type": "concept", "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 7p the ladder RISES 0.022195 mHa. F80.2's number and mechanism survive; its words do not - 'basin floor' is the wrong name and the direction had been assumed from one configuration."}, {"id": "recovered_session_81_combined_f81_2", "label": "F81.2 TOL a Thousand Times Too Small (the Units Again)", "file_type": "concept", "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_session_81_combined_f81_4", "label": "F81.4 A str_replace Patch Deleted a Function Header", "file_type": "concept", "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "widen() swallowed canfail(); the effect was benign because the gate then ran MORE often, and that is explicitly not accepted as a defence."}, {"id": "recovered_session_81_combined_seven_rulings", "label": "M's Seven Rulings (RULING-S81-SEVEN-RULINGS.md)", "file_type": "document", "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_session_81_combined_handoff", "target": "recovered_session_80_combined_handoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_session_81_combined_handoff", "target": "recovered_session_81_combined_fixed81", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_session_81_combined_handoff", "target": "recovered_session_81_combined_de81", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_session_81_combined_handoff", "target": "recovered_session_81_combined_seven_rulings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_session_81_combined_fixed81", "target": "recovered_session_79_combined_fixed79", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-81-COMBINED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_session_81_combined_de81", "target": "recovered_session_80_combined_de80", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-81-C