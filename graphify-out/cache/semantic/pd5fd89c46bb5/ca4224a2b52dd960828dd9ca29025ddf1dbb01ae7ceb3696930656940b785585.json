{"nodes": [{"id": "recovered_handoff_32_handoff_32", "label": "HANDOFF (chat 30 to chat 31), 2026-08-26", "file_type": "document", "source_file": "recovered/HANDOFF-32.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_32_reading_gate", "label": "The Reading Gate (execute before any other work)", "file_type": "rationale", "source_file": "recovered/HANDOFF-32.md", "source_location": "lines 11-85", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The pre-restart generation of the open ritual: a numbered gate with G0 checks that must be run and closed, not carried, so no finding rests on an unverified tree."}, {"id": "recovered_handoff_32_ruling_56_lowdin_external_check", "label": "Ruling 56: the Lowdin solution as external check", "file_type": "concept", "source_file": "recovered/HANDOFF-32.md", "source_location": "lines 137-152", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It supplies an external check where the project had only internal consistency, so a disagreement between an index and the Lowdin solution becomes a finding about the index rather than a tie; but its scope - what counts as 'the original input at the project's start' - had to be settled by reading before anything could rest on it."}, {"id": "recovered_handoff_32_instruments_unrecoverable", "label": "Ruling 41: the missing instruments are not recoverable", "file_type": "rationale", "source_file": "recovered/HANDOFF-32.md", "source_location": "lines 92-99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "guard.py, press_all.py, mkref.py and ten others lived in deleted chats; the ruling closes the question permanently so no chat spends time searching Drive or asking the author, and repair is allowed where rebuilding is not."}, {"id": "recovered_handoff_32_coords_py_silent_death", "label": "coords.py died silently for a whole build (W-036)", "file_type": "concept", "source_file": "recovered/HANDOFF-32.md", "source_location": "lines 170-175", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ruling 49's heading promotion at chat 28 killed two of its four checks the moment it was built and no press ran at chat 29 to catch it - a gate that passes because it stopped checking is worse than no gate."}, {"id": "recovered_handoff_32_b7_spectra_stable_merge", "label": "B7: SPEC-06's reorder built as a stable merge (W-035)", "file_type": "concept", "source_file": "recovered/HANDOFF-32.md", "source_location": "lines 154-169", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stable merge was chosen because 50 of 90 multi-row runs violate levels-descending, so no intra-species convention existed to preserve and imposing one would have exceeded the finding; sort key is element then ionisation by roman value so a future stage cannot break the order silently."}, {"id": "recovered_handoff_32_press_invocation", "label": "Press invocations (build.py argv conventions)", "file_type": "concept", "source_file": "recovered/HANDOFF-32.md", "source_location": "lines 126-135", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_32_ref_docx_recipe", "label": "ref.docx rebuild recipe (not a bundle member)", "file_type": "concept", "source_file": "recovered/HANDOFF-32.md", "source_location": "lines 101-110", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_32_figures_not_members", "label": "Figures and COORDINATES are not bundle members", "file_type": "rationale", "source_file": "recovered/HANDOFF-32.md", "source_location": "lines 111-125", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They are refetched and hash-verified each session that presses rather than carried in the bundle, because a binary inside the bundle cannot be diffed and would make every build's md5 depend on a zip."}], "edges": [{"source": "recovered_handoff_32_handoff_32", "target": "recovered_handoff_32_reading_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/HANDOFF-32.md", "source_location": "line 11", "weight": 1.0}, {"source": "recovered_handoff_32_handoff_32", "target": "recovered_handoff_32_ruling_56_lowdin_external_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/HANDOFF-32.md", "source_location": "lines 137-152", "weight": 1.0}, {"source": "recovered_handoff_32_handoff_32", "target": "recovered_handoff_32_instruments_unrecoverable", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/HANDOFF-32.md", "source_location": "lines 92-99", "weight": 1.0}, {"source": "recovered_handoff_32_handoff_32", "target": "recovered_handoff_32_coords_py_silent_death", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/HANDOFF-32.md", "source_location": "lines 170-175", "weight": 1.0}, {"source": "recovered_handoff_32_handoff_32", "target": "recovered_handoff_32_b7_spectra_stable_merge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/HANDOFF-32.md", "source_location": "lines 154-169", "weight": 1.0}, {"source": "recovered_handoff_32_handoff_32", "target": "recovered_handoff_32_press_invocation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/HANDOFF-32.md", "source_location": "lines 126-135", "weight": 1.0}, {"source": "recovered_handoff_32_handoff_32", "target": "recovered_handoff_32_ref_docx_recipe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/HAND