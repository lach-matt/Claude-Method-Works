{"nodes": [{"id": "recovered_repair_and_additions_repair_additions_ledger", "label": "REPAIR & ADDITIONS LEDGER \u2014 The Method 1.6", "file_type": "document", "source_file": "recovered/REPAIR-AND-ADDITIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A living list: entries are appended as prose work progresses and never silently dropped, and the pass closes only when the named repairs are done and recorded."}, {"id": "recovered_repair_and_additions_no_silent_change", "label": "NO-SILENT-CHANGE discipline", "file_type": "rationale", "source_file": "recovered/REPAIR-AND-ADDITIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every volume change is recorded by a Register entry in the same build and a guard run blocks the handoff on a FAIL, so no volume can move unrecorded."}, {"id": "recovered_repair_and_additions_a1_tower_rows_non_closing_object", "label": "A1 \u2014 the tower rows print the non-closing exact-triangle object", "file_type": "concept", "source_file": "recovered/REPAIR-AND-ADDITIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The canonical figures are the envelope build; the printed pair belongs to a different object already named in the compendium, so only the Index of Indices rows are fixed."}, {"id": "recovered_repair_and_additions_a2_composable_columns_wrong_object", "label": "A2 \u2014 composable columns computed on the wrong object", "file_type": "concept", "source_file": "recovered/REPAIR-AND-ADDITIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The counts were computed on the triangle object and must be recomputed on the canonical envelope build; the input is regenerable from banked scripts."}, {"id": "recovered_repair_and_additions_a3_axis10_parity_annotation", "label": "A3 \u2014 the axis-10 'parity' annotation mislabels the bound", "file_type": "concept", "source_file": "recovered/REPAIR-AND-ADDITIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parity belongs to the exact set, not the admissible bound, so the repair is a one-word annotation strike and no compendium repair follows."}, {"id": "recovered_repair_and_additions_a4_triangle_e_census_named_not_verified", "label": "A4 \u2014 the triangle-object E census is named, not verified", "file_type": "concept", "source_file": "recovered/REPAIR-AND-ADDITIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identification already rests on two exact counts and the compendium's own naming, so the census is confirmation only and may be accepted as the standing record."}], "edges": [{"source": "recovered_repair_and_additions_no_silent_change", "target": "recovered_repair_and_additions_repair_additions_ledger", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/REPAIR-AND-ADDITIONS.md", "source_location": null, "weight": 1.0}, {"source": "recovered_repair_and_additions_repair_additions_ledger", "target": "recovered_repair_and_additions_a1_tower_rows_non_closing_object", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/REPAIR-AND-ADDITIONS.md", "source_location": null, "weight": 1.0}, {"source": "recovered_repair_and_additions_repair_additions_ledger", "target": "recovered_repair_and_additions_a2_composable_columns_wrong_object", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/REPAIR-AND-ADDITIONS.md", "source_location": null, "weight": 1.0}, {"source": "recovered_repair_and_additions_repair_additions_ledger", "target": "recovered_repair_and_addit