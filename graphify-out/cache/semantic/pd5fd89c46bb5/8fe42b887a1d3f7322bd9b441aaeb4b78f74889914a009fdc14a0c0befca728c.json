{"nodes": [{"id": "recovered_handoff_69_handoff_69", "label": "HANDOFF-69 \u2014 chat 116 to chat 117", "file_type": "document", "source_file": "recovered/HANDOFF-69.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chat 116 took HANDOFF-68's fuller offer, closing \u00a730.2 with all three subsections and entering \u00a730.3 at its own head, because \u00a730.3's nine subsections over 176 lines cannot close in one chat whatever cut is taken."}, {"id": "recovered_handoff_69_chat_116_unit_l8347_l8450", "label": "Chat 116 unit L8347\u2013L8450 (\u00a730.2 through \u00a730.3.2)", "file_type": "concept", "source_file": "recovered/HANDOFF-69.md", "source_location": "L151", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_69_finding_16b_01", "label": "16b-01 / 16b-02 \u2014 two count words in one section, each refuted by its own table", "file_type": "rationale", "source_file": "recovered/HANDOFF-69.md", "source_location": "L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PP prints the same four rows in both tables, so this is an authoring gap and not production loss."}, {"id": "recovered_handoff_69_finding_16b_03", "label": "16b-03 \u2014 a regression unreproducible from the table it is printed under", "file_type": "rationale", "source_file": "recovered/HANDOFF-69.md", "source_location": "L159", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slope 2.33 against a printed 2.29 and R-squared 1.00 against 0.37\u20130.42; an R-squared near 0.4 belongs to a per-instance fit over 1,480 instances that are nowhere printed."}, {"id": "recovered_handoff_69_finding_16b_04", "label": "16b-04 \u2014 a pointer whose target carries none of its claim (\u00a730.3.3)", "file_type": "rationale", "source_file": "recovered/HANDOFF-69.md", "source_location": "L163", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The five claim tokens score zero under coincident resolvers, and the claim's real home is main L686\u2013L693 \u2014 the absence is only a finding because where the claim does live was located."}, {"id": "recovered_handoff_69_finding_16b_05", "label": "16b-05 \u2014 a caption denominator matching nothing measurable (114 of 141)", "file_type": "rationale", "source_file": "recovered/HANDOFF-69.md", "source_location": "L167", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_69_finding_16b_06", "label": "16b-06 / 16b-07 \u2014 a splice and a broken paragraph, both original", "file_type": "rationale", "source_file": "recovered/HANDOFF-69.md", "source_location": "L169", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The unit is byte-identical to Prints & Proofs at offset -78, so both defects were authored rather than introduced in production."}, {"id": "recovered_handoff_69_prints_and_proofs", "label": "Prints & Proofs \u2014 the original read before any question is asked", "file_type": "concept", "source_file": "recovered/HANDOFF-69.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reading PP first settles whether a defect is authoring or production, and in chat 116 it settled two count-word findings as authoring gaps in a single call."}, {"id": "recovered_handoff_69_fault_min_over_frozensets", "label": "Never canonicalise set orbits with min over frozensets", "file_type": "rationale", "source_file": "recovered/HANDOFF-69.md", "source_location": "L172", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subset is a partial order, not a total one, so min returns 256 orbits where the truth is 80."}, {"id": "recovered_handoff_69_r2_ch16b", "label": "r2-ch16b \u2014 chat 117's computable instrument", "file_type": "code", "source_file": "recovered/HANDOFF-69.md", "source_location": "L238", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_69_r2_ch16c", "label": "r2-ch16c \u2014 chat 117's prose instrument", "file_type": "code", "source_file": "recovered/HANDOFF-69.md", "source_location": "L238", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_handoff_69_read_ch16b", "label": "READ-ch16b.md \u2014 chat 116's section-read member", "file_type": "document", "source_file": "recovered/HANDOFF-69.md", "source_location": "L152", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_handoff_69_handoff_69", "target": "recovered_handoff_69_chat_116_unit_l8347_l8450", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/HANDOFF-69.md", "source_location": "L151", "weight": 1.0}, {"source": "recovered_handoff_69_finding_16b_01", "target": "recovered_handoff_69_chat_116_unit_l8347_l8450", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/HANDOFF-69.md", "source_location": "L151", "weight": 1.0}, {"source": "recovered_handoff_69_read_ch16b", "target": "recovered_handoff_69_finding_16b_01", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/HANDOFF-69.md", "source_location": "L152", "weight": 1.0}, {"source": "recovered_handoff_69_finding_16b_03", "target": "recovered_handoff_69_chat_116_unit_l8347_l8450", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/HANDOFF-69.md", "source_location": "L151", "weight": 1.0}, {"source": "recovered_handoff_69_read_ch16b", "target": "recovered_handoff_69_finding_16b_03", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file":