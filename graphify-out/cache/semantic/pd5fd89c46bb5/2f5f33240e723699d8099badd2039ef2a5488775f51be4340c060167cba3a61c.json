{"nodes": [{"id": "recovered_prediction_fk_scale_session_39_document", "label": "PREDICTION-FK-SCALE (s39 item 1)", "file_type": "document", "source_file": "recovered/PREDICTION-FK-SCALE-SESSION-39.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_fk_scale_session_39_lambda_feasibility_interval", "label": "The lambda feasibility interval, gap(lambda) = gap_avg + lambda*D", "file_type": "concept", "source_file": "recovered/PREDICTION-FK-SCALE-SESSION-39.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run as a feasibility interval because adopting any value of lambda from the answer would be a fitted constant; the interval is the measurement."}, {"id": "recovered_prediction_fk_scale_session_39_feasible_but_inconsistent", "label": "PF-5: the predicted verdict FEASIBLE BUT INCONSISTENT", "file_type": "rationale", "source_file": "recovered/PREDICTION-FK-SCALE-SESSION-39.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A window near lambda 0.21-0.39 means F^k reduced by 60-80% against a physical screening of 10-30%, so a uniform F^k scale is refused as the mechanism even though a window exists, and the interval becomes a measurement of how far the residual is from screening."}, {"id": "recovered_prediction_fk_scale_session_39_no_constant_beyond_c", "label": "No constant beyond c = 137.035999", "file_type": "concept", "source_file": "recovered/PREDICTION-FK-SCALE-SESSION-39.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_prediction_fk_scale_session_39_document", "target": "recovered_prediction_fk_scale_session_39_lambda_feasibility_interval", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDI