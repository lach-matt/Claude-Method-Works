{"nodes": [{"id": "recovered_fault_f62_1_foreign_provenance_f62_1", "label": "Fault F62.1 \u2014 four files of unestablished provenance entered and were sealed", "file_type": "document", "source_file": "recovered/FAULT-F62.1-FOREIGN-PROVENANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_fault_f62_1_foreign_provenance_seal_asserts_authorship", "label": "A seal should assert authorship, not merely integrity", "file_type": "rationale", "source_file": "recovered/FAULT-F62.1-FOREIGN-PROVENANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "condense.py verifies that files match their hashes; nothing verifies that a file was WRITTEN BY the session sealing it. A hash proves a file did not change, not where it came from. Proposal: the seal records a count of files created during the session's own transcript and HALTS on any excess, exactly as an undeclared removal does. Correct content from an unestablished source is still an unestablished source when the project's whole claim is attributability."}], "edges": [{"source": "recovered_fault_f62_1_foreign_provenance_seal_asserts_authorship", "target": "recovered_fault_f62_1_foreign_provenance_f62_1", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/FAULT-F62.1-FOREIGN-PROVENANCE.md", "source_location": null, "weight": 1.0}, {"source": "recovered_fault_f62_1_foreign_provenance_f62_1", "target": "recovered_fault_f61_2_dropped_channel_margin_f61_2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/FAULT-F62.1-FOREIGN-PROVENANCE.md", "source_location": null, "weight": 1.0}, {"source": "recovered_fault_f62_1_foreign_provenance_f62_1", "target": "recovered_fault_f61_1_preguard_rows_f61_1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "s