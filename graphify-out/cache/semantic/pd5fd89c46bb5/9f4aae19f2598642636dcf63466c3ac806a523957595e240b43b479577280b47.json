{"nodes": [{"id": "recovered_prediction_frozen_split_session_26_prediction_frozen_split_s26", "label": "PREDICTION (session 26): is the frozen ratio 1.15 derivable?", "file_type": "document", "source_file": "recovered/PREDICTION-FROZEN-SPLIT-SESSION-26.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Written before any run under the ruling 'continue in order'; the aim is a derived form for the frozen mask rather than a fitted ratio."}, {"id": "recovered_prediction_frozen_split_session_26_midpoint_defect_m_t", "label": "Midpoint defect M_T = int_0^1 <n_ent|v_T(f)>df - <n_ent|v_T(1/2)> per potential term", "file_type": "rationale", "source_file": "recovered/PREDICTION-FROZEN-SPLIT-SESSION-26.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every f-dependent term has an exact frozen-orbital derivative, so the mask decomposes term by term with nothing fitted; V_H and the Hartree SIC are linear in f and have M=0 exactly."}, {"id": "recovered_prediction_frozen_split_session_26_m_xsic_closed_form", "label": "M_xsic = 0.0583 E_x[n_ent], with 0.0583 = (4/3)2^(-1/3) - 1", "file_type": "rationale", "source_file": "recovered/PREDICTION-FROZEN-SPLIT-SESSION-26.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A closed form, so it gates the numerics: the fine grid must reproduce it to 1e-4 before any other row is read."}, {"id": "recovered_prediction_frozen_split_session_26_m_resp_orbital_response", "label": "M_resp = mask_fr - M_exp, the entrant orbital's own response", "file_type": "rationale", "source_file": "recovered/PREDICTION-FROZEN-SPLIT-SESSION-26.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Predicted negative on every row by Rayleigh-Ritz (eps_fr(f) <= <psi_ref|H_f|psi_ref>, equality at f=1/2), and predicted to be <=15% of the mask so the mask is computable without any f-scan."}, {"id": "recovered_prediction_frozen_split_session_26_frozen_split_py", "label": "frozen_split.py", "file_type": "concept", "source_file": "recovered/PREDICTION-FROZEN-SPLIT-SESSION-26.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_prediction_frozen_split_session_26_prediction_frozen_split_s26", "target": "recovered_prediction_frozen_split_session_26_midpoint_defect_m_t", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-FROZEN-SPLIT-SESSION-26.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_frozen_split_session_26_m_xsic_closed_form", "target": "recovered_prediction_frozen_split_session_26_midpoint_defect_m_t", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-FROZEN-SPLIT-SESSION-26.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_frozen_split_session_26_m_resp_orbital_response", "target": "recovered_prediction_frozen_split_session_26_midpoint_defect_m_t", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-FROZEN-SPLIT-SESSION-26.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_frozen_split_session_26_prediction_frozen_split_s26", "target": "recovered_prediction_frozen_split_session_26_frozen_split_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-FROZEN-SPLIT-SESSION-26.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_frozen_split_session_26_prediction_frozen_split_s26", "target": "recovered_prediction_frozen_split_session_26_m_resp_orbital_response", "relation": "references", "confidence": "E