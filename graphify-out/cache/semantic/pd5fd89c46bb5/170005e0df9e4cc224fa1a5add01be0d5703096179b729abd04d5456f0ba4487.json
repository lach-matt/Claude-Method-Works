{"nodes": [{"id": "recovered_prediction_e0b_session_31_document", "label": "PREDICTION-E0B (s31, zeta dependence of the second-order exchange constant)", "file_type": "document", "source_file": "recovered/PREDICTION-E0B-SESSION-31.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_prediction_e0b_session_31_e0b_zeta_independence", "label": "E0B(zeta) = E0B(0): the second-order exchange constant is zeta-independent", "file_type": "concept", "source_file": "recovered/PREDICTION-E0B-SESSION-31.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bare second-order exchange diagram couples same-spin pairs only and scales as a density-independent constant per particle of that species, so summing species leaves a constant and the owed refinement resolves to zero."}, {"id": "recovered_prediction_e0b_session_31_f31_1_timing_flag", "label": "F31.1 \u2014 the timing flag on a literature read entered after the derivation", "file_type": "rationale", "source_file": "recovered/PREDICTION-E0B-SESSION-31.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The scaling argument was reasoned first but the file was written after a literature read stating the same result, so the read is entered as a check on the derivation, not as a prediction of it."}, {"id": "recovered_prediction_e0b_session_31_form_r_cs_cut", "label": "PE3: the Cs 31% cut is a property of form R itself", "file_type": "concept", "source_file": "recovered/PREDICTION-E0B-SESSION-31.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_prediction_e0b_session_31_document", "target": "recovered_prediction_e0b_session_31_e0b_zeta_independence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "so