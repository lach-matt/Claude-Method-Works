{"nodes": [{"id": "recovered_solver_finding_solver_finding", "label": "Solver Finding - Loewdin Session 4 (Bridge \u00a74 Step 1)", "file_type": "document", "source_file": "recovered/SOLVER-FINDING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_solver_finding_tf_gate_fails", "label": "The TF/Latter Gate Fails at rms 0.315", "file_type": "concept", "source_file": "recovered/SOLVER-FINDING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thirty-nine channels over ten species: rms 0.315, mean signed -0.257 (under-bound throughout) against the fitted Q.final's rms 0.14. The prediction of rms 0.1-0.3 was stated before the run and held at its upper edge."}, {"id": "recovered_solver_finding_d_collapse_yes_f_collapse_no", "label": "TF Carries Every d-Collapse and No f-Collapse", "file_type": "concept", "source_file": "recovered/SOLVER-FINDING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two inversions (La 5d, Ac 6d) come out of one-electron TF while the f openings (Ce, Pa) do not, and the f defect stays near zero at all Z. Latter's own boundary: the f drop needs exchange (TFD) or better."}, {"id": "recovered_solver_finding_two_solver_faults", "label": "Two Solver Faults Found and Fixed Before Any Result Was Read", "file_type": "concept", "source_file": "recovered/SOLVER-FINDING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A symmetrised log-mesh tridiagonal with 1e17 dynamic range returned one eigenvalue k times, and a bisection floor of -0.6 Z^2 put h^2 q/12 > 1 at deep E and produced 119 spurious nodes at E=-200. Both are an instrument reporting on what it admitted - recorded, not hidden."}, {"id": "recovered_solver_finding_numerov_shooting", "label": "Numerov Shooting Replaces the Symmetrised Log-Mesh Tridiagonal", "file_type": "concept", "source_file": "recovered/SOLVER-FINDING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_solver_finding_step_2_not_unlocked", "label": "Step 2 Is Not Unlocked: TF Is Worse Than the Fit It Would Replace", "file_type": "rationale", "source_file": "recovered/SOLVER-FINDING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A computed grade cannot be regenerated from a solver that loses to the fit, so the 'computed' grade stays Q.final, the index equation remains a fit, and the record must say so. TFD with the same gate is the candidate next segment."}], "edges": [{"source": "recovered_solver_finding_solver_finding", "target": "recovered_solver_finding_tf_gate_fails", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SOLVER-FINDING.md", "source_location": null, "weight": 1.0}, {"source": "recovered_solver_finding_solver_finding", "target": "recovered_solver_finding_two_solver_faults", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SOLVER-FINDING.md", "source_location": null, "weight": 1.0}, {"source": "recovered_solver_finding_tf_gate_fails", "target": "recovered_solver_finding_d_collapse_yes_f_collapse_no", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SOLVER-FINDING.md", "source_location": null, "weight": 1.0}, {"source": "recovered_solver_finding_two_solver_faults", "target": "recovered_solver_finding_numerov_shooting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SOLVER-FINDING.md", "source_location": null, "weight": 1.0}, {"source": "recovered_solver_finding_step_2_not_unlocked", "target": "recovered_solver_finding_tf_gate_fails", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SOLVER-FINDING.md", "source_location": null, "weight": 1.0}, {"source": "recovered_solver_finding_step_2_not_unlocked", "target": "recovered_solver_finding_d_collapse_yes_f_collapse_no", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SOLVER-FINDING.md", "source_location": null, "weight": 1.0}, {"source": "recovered_solver_finding_d_collapse_yes_f_collapse_no", "target": "recovered_session_84_combined_orbital_collapse_two_wells", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "recovered/SOLVER-FINDING.md", "source_location": null, "weight": 1.0}, {"source": "recovered_solver_finding_two_solver_faults", "target": "recovered_session_79_combined_the_species", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "recovered/SOLVER-FINDING.md", "source_location": null, "weight": 1.0}], "hyperedges": []}