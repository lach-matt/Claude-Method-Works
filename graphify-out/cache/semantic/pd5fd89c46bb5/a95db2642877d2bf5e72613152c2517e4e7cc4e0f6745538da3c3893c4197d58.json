{"nodes": [{"id": "_github_workflows_claude_code_review_review_workflow", "label": "Claude Code Review workflow", "file_type": "code", "source_file": ".github/workflows/claude-code-review.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automation mode: a prompt input runs the code-review plugin skill read-only on every pull_request event with no @claude mention."}, {"id": "_github_workflows_claude_code_review_changed_files_gate", "label": "changed-files job-level gate", "file_type": "code", "source_file": ".github/workflows/claude-code-review.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lists the PR's files through gh api --paginate and publishes has_non_drive and has_key as outputs, because the secrets context is unavailable in a job-level if:."}, {"id": "_github_workflows_claude_code_review_sparse_checkout", "label": "Sparse checkout excluding drive/", "file_type": "code", "source_file": ".github/workflows/claude-code-review.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Takes the working tree from 508 MB to a few kilobytes; the diff comes from the PR API, and with fetch-depth 1 there is no base commit on disk anyway."}, {"id": "_github_workflows_claude_code_review_partial_review_hazard", "label": "Cancelling mid-review strands a partial review", "file_type": "rationale", "source_file": ".github/workflows/claude-code-review.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The job posts inline comments as it works and the code-review skill skips any PR already carrying a Claude comment, so a cancelled run would leave a truncated review that every replacement run then skips."}, {"id": "_github_workflows_claude_code_review_fork_gate", "label": "Fork and missing-key gates", "file_type": "rationale", "source_file": ".github/workflows/claude-code-review.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fork PRs get no secrets and id-token downgraded to read, so the action cannot authenticate; skipping cleanly beats failing red on a condition the PR author cannot fix."}], "edges": [{"source": "_github_workflows_claude_code_review_changed_files_gate", "target": "_github_workflows_claude_code_review_review_workflow", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/claude-code-review.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_claude_code_review_sparse_checkout", "target": "_github_workflows_claude_code_review_review_workflow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/claude-code-review.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_claude_code_review_partial_review_hazard", "target": "_github_workflows_claude_code_review_review_workflow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/claude-code-review.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_claude_code_review_fork_gate", "target": "_github_workflows_claude_code_review_review_workflow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/claude-code-review.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_claude_code_review_sparse_checkout", "target": "claude_drive_mirror", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".github/workflows/claude-code-review.yml", "source_location": null, "weight": 1.0}], "hyperedges": []}