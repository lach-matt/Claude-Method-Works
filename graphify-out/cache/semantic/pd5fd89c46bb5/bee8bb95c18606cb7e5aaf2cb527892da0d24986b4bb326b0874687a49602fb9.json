{"nodes": [{"id": "docs_recover_recover_py", "label": "recover.py \u2014 the artefacts the chats wrote", "file_type": "concept", "source_file": "docs/RECOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "COVERAGE.tsv could say which conversation holds a missing artefact; this extracts the bodies instead, and --verify re-hashes the tree against LEDGER.tsv."}, {"id": "docs_recover_wanted_set_reach", "label": "The wanted-set is its reach, not a bug", "file_type": "rationale", "source_file": "docs/RECOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The set is COVERAGE.tsv's artefact column \u2014 names of filename shape \u2014 so anything named another way is invisible however often it is re-run."}, {"id": "docs_recover_recovered_by_write", "label": "RECOVERED-BY-WRITE \u2014 768 files found from the other direction", "file_type": "concept", "source_file": "docs/RECOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Walking every tool call that wrote a file and keeping those the repository holds under neither name nor md5; only one of the 760 candidates was content already held, and the other 759 were new bodies."}, {"id": "docs_recover_recovered_truncated", "label": "RECOVERED-TRUNCATED \u2014 a body a paging viewer elided", "file_type": "concept", "source_file": "docs/RECOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The display is valid text and hashes cleanly, so --verify passed it and the ledger once called it RECOVERED; 23 files are affected, every one from the code-block rule and none from the heredoc rule."}, {"id": "docs_recover_completeness_outranks_recency", "label": "Completeness outranks recency", "file_type": "rationale", "source_file": "docs/RECOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordering by conversation date alone let a truncated body hold the plain name while the full document hid behind a suffix; HANDOFF-53.md went from 16,165 to 29,951 bytes on that change alone."}, {"id": "docs_recover_idempotence_defect", "label": "The tool was not idempotent", "file_type": "concept", "source_file": "docs/RECOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Its code-block rule asked COVERAGE.tsv which names the repo lacked, but COVERAGE.tsv is regenerated from recovered/, so every recovered name turned HELD and vanished from the next run's wanted-set. 2,337 is the superseded figure."}, {"id": "docs_recover_recovered_not_mirrored", "label": "RECOVERED is not mirrored", "file_type": "rationale", "source_file": "docs/RECOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "These bytes were measured out of the export, not fetched from the file they were written to; no recovered file is claimed byte-identical to a copy held elsewhere and none is a member of a bundle."}, {"id": "docs_recover_versions_kept", "label": "Versions are kept rather than resolved", "file_type": "rationale", "source_file": "docs/RECOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "147 names were written more than once with differing content because the work evolved across chats; the ledger carries the conversation and date for every version, so the order is evidence rather than assertion."}, {"id": "docs_recover_heredoc_negative_result", "label": "The heredoc route measured, as a negative result", "file_type": "concept", "source_file": "docs/RECOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2,056 distinct heredoc targets with a body, 9 the repository did not hold; the other 2,047 were already held, so between the two passes the shape is covered and the shell is not where anything is hiding."}, {"id": "docs_recover_unrecoverable_uploads", "label": "Files uploaded into a chat cannot be recovered", "file_type": "rationale", "source_file": "docs/RECOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They appear as a files entry with a name and uuid and no content whatsoever; and bodies shown only as a view tool result carry line numbers, so de-numbering them would be reconstruction rather than recovery."}], "edges": [{"source": "docs_recover_wanted_set_reach", "target": "docs_coverage_coverage_py", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RECOVER.md", "source_location": null, "weight": 1.0}, {"source": "docs_recover_recovered_by_write", "target": "docs_handoff_gap_structural_read", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RECOVER.md", "source_location": null, "weight": 1.0}, {"source": "docs_recover_recover_py", "target": "claude_recovered_tree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RECOVER.md", "source_location": null, "weight": 1.0}, {"source": "docs_recover_wanted_set_reach", "target": "docs_recover_recover_py", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RECOVER.md", "source_location": null, "weight": 1.0}, {"source": "docs_recover_recovered_by_write", "target": "docs_recover_wanted_set_reach", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RECOVER.md", "source_location": null, "weight": 1.0}, {"source": "docs_recover_recovered_truncated", "target"