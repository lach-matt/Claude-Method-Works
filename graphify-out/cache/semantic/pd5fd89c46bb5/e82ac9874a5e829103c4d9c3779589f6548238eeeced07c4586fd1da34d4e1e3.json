{"nodes": [{"id": "recovered_readme_handoff_45_lowdin_handoff_45", "label": "LOWDIN-HANDOFF-45 superset archive (session 45)", "file_type": "document", "source_file": "recovered/README-HANDOFF-45.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_readme_handoff_45_f45_1_sed_a_session_named_copy", "label": "F45.1 \u2014 the sed must target a session-named copy", "file_type": "rationale", "source_file": "recovered/README-HANDOFF-45.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Root gates_run.sh is manifest-listed, so editing it in place makes the seal check report bad=1: a procedure that mutates a sealed file cannot precede the gate that checks sealed files."}, {"id": "recovered_readme_handoff_45_f45_2_diff_latest_sealed_log", "label": "F45.2 \u2014 diff against the latest sealed log, never an older one", "file_type": "rationale", "source_file": "recovered/README-HANDOFF-45.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The s44 log's PT8 block is a hand-condensed one-liner rather than the instrument's stdout, so it cannot be diffed; per H.4 the sealed log is not rewritten."}, {"id": "recovered_readme_handoff_45_gate_83_nlcfg", "label": "Gate 83 (nlcfg.py) \u2014 the configuration gate", "file_type": "concept", "source_file": "recovered/README-HANDOFF-45.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A gate whose expectation grows with the chain must restate it in its own text, and the restatement is the next session's first contact with the gate."}, {"id": "recovered_readme_handoff_45_growth_is_not_divergence", "label": "Growth is not divergence (s45 general ruling)", "file_type": "rationale", "source_file": "recovered/README-HANDOFF-45.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A scored count that rises because the chain got longer is not evidence that anything moved; only a change in a length-invariant expectation is divergence."}, {"id": "recovered_readme_handoff_45_config_and_step_travel_together", "label": "CONFIG and STEP scores travel together; neither is quoted alone", "file_type": "rationale", "source_file": "recovered/README-HANDOFF-45.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 1969 challenge names both scores, so quoting the step score alone restates the s44 fault the configuration column lifted."}], "edges": [{"source": "recovered_readme_handoff_45_lowdin_handoff_45", "target": "recovered_readme_handoff_44_lowdin_handoff_44", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/README-HANDOFF-45.md", "source_location": null, "weight": 1.0}, {"source": "recovered_readme_handoff_45_f45_1_sed_a_session_named_copy", "target": "recovered_readme_handoff_45_lowdin_handoff_45", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/README-HANDOFF-45.md", "source_location": null, "weight": 1.0}, {"source": "recovered_readme_handoff_45_f45_2_diff_latest_sealed_log", "target": "recovered_readme_handoff_45_lowdin_handoff_45", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/README-HANDOFF-45.md", "source_location": null, "weight": 1.0}, {"source": "recovered_readme_handoff_45_lowdin_handoff_45", "target": "recovered_readme_handoff_44_verify_two_halves", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/README-HANDOFF-45.md", "source_location": null, "weight": 1.0}, {"source": "recovered_readme_handoff_45_growth_is_not_divergence", "target": "recovered_readme_hand