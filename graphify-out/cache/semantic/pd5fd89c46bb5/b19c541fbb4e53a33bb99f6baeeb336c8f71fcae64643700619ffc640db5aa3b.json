{"nodes": [{"id": "recovered_readme_handoff_47_lowdin_handoff_47", "label": "LOWDIN-HANDOFF-47 superset archive (session 47)", "file_type": "document", "source_file": "recovered/README-HANDOFF-47.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_readme_handoff_47_f47_1_written_not_copied", "label": "F47.1 \u2014 a handoff README is written, never copied", "file_type": "rationale", "source_file": "recovered/README-HANDOFF-47.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HANDOFF-46's README was a byte-identical copy of HANDOFF-45's and carried four stale clauses; one would have layered the chain short and silently lost two elements. Check the header against the bridge before trusting a recipe."}, {"id": "recovered_readme_handoff_47_f47_2_unflagged_scf_nonconvergence", "label": "F47.2 \u2014 run2 returns at maxit with no flag", "file_type": "rationale", "source_file": "recovered/README-HANDOFF-47.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cycling SCF yields a total energy indistinguishable from a converged one, so nlguard.run_guarded's rung ladder is the repair and a channel converging at no rung returns NO NUMBER."}, {"id": "recovered_readme_handoff_47_f47_3_mixed_rung_value", "label": "F47.3 \u2014 a guarded D is mixed-rung", "file_type": "rationale", "source_file": "recovered/README-HANDOFF-47.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It carries ~1e-5 in its last stored digit and therefore cannot flip an ordering; the limit is stated so the digit is not over-read."}, {"id": "recovered_readme_handoff_47_gate_84_nlguard", "label": "Gate 84 (nlguard.py) \u2014 chain-length-invariant expectations", "file_type": "concept", "source_file": "recovered/README-HANDOFF-47.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Its expectations are invariant by construction and must never be restated; restating them would destroy the only gate that can detect divergence."}, {"id": "recovered_readme_handoff_47_z57_unsealed_candidate", "label": "Z=57 computed and not sealed (UNSEALED-CANDIDATE)", "file_type": "concept", "source_file": "recovered/README-HANDOFF-47.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It came from nlstep47.py rather than nlchain.py, so appending it by hand would mix instruments in one file \u2014 M's ruling is owed before the seal."}], "edges": [{"source": "recovered_readme_handoff_47_lowdin_handoff_47", "target": "recovered_readme_handoff_45_lowdin_handoff_45", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/README-HANDOFF-47.md", "source_location": null, "weight": 1.0}, {"source": "recovered_readme_handoff_47_f47_1_written_not_copied", "target": "recovered_readme_handoff_47_lowdin_handoff_47", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/README-HANDOFF-47.md", "source_location": null, "weight": 1.0}, {"source": "recovered_readme_handoff_47_f47_2_unflagged_scf_nonconvergence", "target": "recovered_readme_handoff_47_gate_84_nlguard", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/README-HANDOFF-47.md", "source_location": null, "weight": 1.0}, {"source": "recovered_readme_handoff_47_f47_3_mixed_rung_value", "target": "recovered_readme_handoff_47_f47_2_unflagged_scf_nonconvergence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/README-HANDOFF-47.md", "source_location": null, "weight": 1.0}, {"source": "recovered_readme_handoff_47_lowdin_han