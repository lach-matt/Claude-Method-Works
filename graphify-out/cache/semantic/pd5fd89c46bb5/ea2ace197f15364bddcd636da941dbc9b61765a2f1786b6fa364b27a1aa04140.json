{"nodes": [{"id": "recovered_session_97_combined_handoff", "label": "Session 97 Combined Handoff", "file_type": "document", "source_file": "recovered/SESSION-97-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_session_97_combined_slot_rule_decided", "label": "The Slot Rule Decided by an External Can-Fail", "file_type": "concept", "source_file": "recovered/SESSION-97-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The core's own 6p-7s pair settled it: (1-f) gives +9% PASS, exclusion -50% FAIL. The s^2 -> d^2 block then resums exactly (ratio 0.92), core-core is +0.070 and sign-exact widening for any gap, and dm2(89) totals +0.111 Ha = 3.4x the margin."}, {"id": "recovered_session_97_combined_so97", "label": "so97.py (First-Order Spin-Orbit on the KH Field)", "file_type": "concept", "source_file": "recovered/SESSION-97-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_session_97_combined_dirac_kernel_non_gating", "label": "The Dirac Kernel Is Non-Gating and Was Not Built", "file_type": "concept", "source_file": "recovered/SESSION-97-COMBINED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worst-case narrowing of at most 0.083 Ha against margins of 0.058-0.264 means the full kernel cannot decide any row, so it was scoped and left unbuilt rather than written speculatively."}], "edges": [{"source": "recovered_session_97_combined_handoff", "target": "recovered_session_96_combined_handoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/SESSION-97-COMBINED.md", "source_location": null, "weight": 1.0}, {"source": "recovered_session_97_combined_handoff", "target": "recovered_session_97_combined_s