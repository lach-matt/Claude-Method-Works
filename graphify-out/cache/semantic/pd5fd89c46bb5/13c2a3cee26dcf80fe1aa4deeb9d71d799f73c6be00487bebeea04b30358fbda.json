{"nodes": [{"id": "recovered_rewrite_chapter10_void_the_void", "label": "The Void \u2014 Box Minus Lambda", "file_type": "concept", "source_file": "recovered/REWRITE-chapter10-void.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The excluded cells are exactly those a physical law forbids \u2014 Pauli, the hydrogenic bound, or counting \u2014 so the void is named the shadow of the exclusion principle: nothing else is missing and nothing forbidden survives."}, {"id": "recovered_rewrite_chapter10_void_void_free_fraction", "label": "Void-Free Fraction (27.7-30.1% over 776 Million Pairs)", "file_type": "concept", "source_file": "recovered/REWRITE-chapter10-void.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_rewrite_chapter10_void_shared_coordinate_correlation", "label": "Shared-Coordinate Cause of Constraint Correlation (factor 1.49)", "file_type": "rationale", "source_file": "recovered/REWRITE-chapter10-void.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The measured 30.13% against an independent-product 20.19% is explained by neighbouring constraints sharing a coordinate along the constraint tree, not by 'two origins' \u2014 that earlier explanation collided with Chapter 5's four physical origins and mis-stated the cause."}, {"id": "recovered_rewrite_chapter10_void_eighth_condition", "label": "The Eighth Condition k >= 1 (a definition, not a bound)", "file_type": "rationale", "source_file": "recovered/REWRITE-chapter10-void.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without k >= 1 the tree collapses and twenty-five surviving cells are states rather than transitions; the condition is the fact that Lambda's cells are transitions written as a constraint, and with it the count is 976 in a bounding box of 6,912."}, {"id": "recovered_rewrite_chapter10_void_containment_test", "label": "O(1) Containment Test in Seven Comparisons", "file_type": "concept", "source_file": "recovered/REWRITE-chapter10-void.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recovered_rewrite_chapter10_void_sieve_free_count", "label": "Sieve-Free Count \u2014 Treeness as the Exact Condition", "file_type": "rationale", "source_file": "recovered/REWRITE-chapter10-void.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tree has no cycles for a sieve to correct, so the box count factorises coordinate by coordinate with no Moebius function and no 2^7 inclusion-exclusion; stated as a general law about indices rather than a feature of this one."}, {"id": "recovered_rewrite_chapter10_void_time_as_order", "label": "Time Enters as an Order Between Cells", "file_type": "concept", "source_file": "recovered/REWRITE-chapter10-void.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recovered_rewrite_chapter10_void_the_void", "target": "recovered_rewrite_chapter10_void_void_free_fraction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/REWRITE-chapter10-void.md", "source_location": null, "weight": 1.0}, {"source": "recovered_rewrite_chapter10_void_shared_coordinate_correlation", "target": "recovered_rewrite_chapter10_void_void_free_fraction", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/REWRITE-chapter10-void.md", "source_location": null, "weight": 1.0}, {"source": "recovered_rewrite_chapter10_void_sieve_free_count", "target": "recovered_rewrite_chapter10_void_the_void", "relation": "references", "confidence": "EXTRACTED", "confidence_score"