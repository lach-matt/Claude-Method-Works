{"nodes": [{"id": "recovered_prediction_s91_item1_swing_swing_decomposition", "label": "Swing decomposition swing = P + S", "file_type": "rationale", "source_file": "recovered/PREDICTION-S91-ITEM1-SWING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact by construction: a frozen-entrant control D_fr at Z* splits the collapse swing into a one-proton piece P (core fixed) and an entrant-screening piece S. The identity is required to reproduce the sealed swing to 1e-5, which is the rung-0 reproduction check."}, {"id": "recovered_prediction_s91_item1_swing_proton_term_p", "label": "Proton term P (one proton, core fixed)", "file_type": "concept", "source_file": "recovered/PREDICTION-S91-ITEM1-SWING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Predicted P < 0 with |P| > |swing|: the proton overshoots and the derived quantity is P, not S."}, {"id": "recovered_prediction_s91_item1_swing_screening_term_s", "label": "Screening term S (entrant electron's screening)", "file_type": "concept", "source_file": "recovered/PREDICTION-S91-ITEM1-SWING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Predicted S > 0 on every (row, channel): the entrant electron OPPOSES the swing, taking back part of the proton collapse, with 0.10 < S/|P| < 0.60 at the collapsing channel."}, {"id": "recovered_prediction_s91_item1_swing_wrong_sided_flag", "label": "Wrong-sided order flag at filing", "file_type": "rationale", "source_file": "recovered/PREDICTION-S91-ITEM1-SWING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The order words the swing as what the d gains when entrant screening is removed, i.e. swing = -S with S < 0; the file predicts the OPPOSITE sign and says so before seeing the data, so that either outcome is a recorded finding (cf. F90.1) rather than a reinterpretation."}, {"id": "recovered_prediction_s91_item1_swing_z90_stop_rule", "label": "Z=90 STOP rule (entrant must remain 6d)", "file_type": "concept", "source_file": "recovered/PREDICTION-S91-ITEM1-SWING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If any control solve at Z=90 selects 5f the run stops and reports rather than continuing on a changed configuration; the rule is re-asserted in s92 items 1, 2 and 3."}], "edges": [{"source": "recovered_prediction_s91_item1_swing_swing_decomposition", "target": "recovered_prediction_s91_item1_swing_proton_term_p", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S91-ITEM1-SWING.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s91_item1_swing_swing_decomposition", "target": "recovered_prediction_s91_item1_swing_screening_term_s", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S91-ITEM1-SWING.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s91_item1_swing_wrong_sided_flag", "target": "recovered_prediction_s91_item1_swing_screening_term_s", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "recovered/PREDICTION-S91-ITEM1-SWING.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s91_item1_swing_swing_decomposition", "target": "recovered_prediction_s90_item3_l5_across_d3_collapse_transit", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "recovered/PREDICTION-S91-ITEM1-SWING.md", "source_location": null, "weight": 1.0}, {"source": "recovered_prediction_s91_item1_swing_swing_decomposition", "target": "recovered_prediction_s89_unit1a_pair_nlchain_currency", "relation": "